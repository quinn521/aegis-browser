@@ -0,0 +1,48 @@
+package main
+
+import (
+	"fmt"
+
+	"github.com/xtls/xray-core/app/proxyman"
+	"github.com/xtls/xray-core/core"
+	xhttp "github.com/xtls/xray-core/proxy/http"
+	"github.com/xtls/xray-core/proxy/socks"
+)
+
+func validateAegisOwnedInbound(config *core.Config) error {
+	if config == nil || len(config.Inbound) != 1 || config.Inbound[0] == nil ||
+		config.Inbound[0].ReceiverSettings == nil ||
+		config.Inbound[0].ProxySettings == nil {
+		return fmt.Errorf("Aegis owned mode requires exactly one configured inbound")
+	}
+	inbound := config.Inbound[0]
+	rawReceiver, err := inbound.ReceiverSettings.GetInstance()
+	if err != nil {
+		return err
+	}
+	receiver, ok := rawReceiver.(*proxyman.ReceiverConfig)
+	if !ok || receiver.Listen == nil || receiver.Listen.AsAddress() == nil ||
+		receiver.Listen.AsAddress().String() != "127.0.0.1" ||
+		receiver.StreamSettings != nil || receiver.ReceiveOriginalDestination {
+		return fmt.Errorf("Aegis owned mode requires a plain IPv4 loopback TCP inbound")
+	}
+	ports := receiver.GetPortList().GetRange()
+	if len(ports) != 1 || ports[0] == nil || ports[0].From != ports[0].To || ports[0].From > 65535 {
+		return fmt.Errorf("Aegis owned mode requires a single port")
+	}
+	settings, err := inbound.ProxySettings.GetInstance()
+	if err != nil {
+		return err
+	}
+	switch proxy := settings.(type) {
+	case *xhttp.ServerConfig:
+		if len(proxy.Accounts) == 0 {
+			return nil
+		}
+	case *socks.ServerConfig:
+		if proxy.AuthType == socks.AuthType_NO_AUTH && !proxy.UdpEnabled && len(proxy.Accounts) == 0 {
+			return nil
+		}
+	}
+	return fmt.Errorf("Aegis owned mode requires no-auth HTTP or TCP-only no-auth SOCKS5")
+}
