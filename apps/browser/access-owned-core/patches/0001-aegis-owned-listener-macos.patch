+		if aegisowned.Enabled() {
+			fmt.Println("Failed to start: Aegis owned mode does not dump configuration")
+			os.Exit(23)
+		}
 		clog.ReplaceWithSeverityLogger(clog.Severity_Warning)
 		errCode := dumpConfig()
 		os.Exit(errCode)
@@ -92,21 +101,30 @@ func executeRun(cmd *base.Command, args []string) {
 		os.Exit(0)
 	}
 
+	osSignals := make(chan os.Signal, 1)
+	owned := aegisowned.Enabled()
+	if owned {
+		// The browser can request shutdown as soon as Start publishes the lease.
+		signal.Notify(osSignals, os.Interrupt, syscall.SIGTERM)
+	}
 	if err := server.Start(); err != nil {
 		fmt.Println("Failed to start:", err)
 		os.Exit(-1)
 	}
 	defer server.Close()
+	if owned && !aegisowned.Ready() {
+		fmt.Println("Failed to start: Aegis listener lease was not published")
+		os.Exit(23)
+	}
 
 	// Explicitly triggering GC to remove garbage from config loading.
 	runtime.GC()
 	debug.FreeOSMemory()
 
-	{
-		osSignals := make(chan os.Signal, 1)
+	if !owned {
 		signal.Notify(osSignals, os.Interrupt, syscall.SIGTERM)
-		<-osSignals
 	}
+	<-osSignals
 }
 
 func dumpConfig() int {
@@ -220,11 +238,9 @@ func startXray() (core.Server, error) {
 	// 	return nil, errors.New("failed to configure Lua privileged authorization").Base(err)
 	// }
 
-	configFiles := getConfigFilePath(true)
-
-	c, err := core.LoadConfig(getConfigFormat(), configFiles)
+	c, err := loadXrayConfig()
 	if err != nil {
-		return nil, errors.New("failed to load config files: [", configFiles.String(), "]").Base(err)
+		return nil, err
 	}
 
 	server, err := core.New(c)
@@ -234,3 +250,15 @@ func startXray() (core.Server, error) {
 
 	return server, nil
 }
+
+func loadXrayConfig() (*core.Config, error) {
+	if aegisowned.Enabled() {
+		return loadAegisOwnedConfig()
+	}
+	files := getConfigFilePath(true)
+	c, err := core.LoadConfig(getConfigFormat(), files)
+	if err != nil {
+		return nil, errors.New("failed to load config files: [", files.String(), "]").Base(err)
+	}
+	return c, nil
+}
