@@ -0,0 +1,23 @@
+//go:build !darwin || !aegis_owned
+
+package aegisowned
+
+import (
+	"context"
+	"fmt"
+	"net"
+)
+
+func Enabled() bool { return false }
+func Ready() bool   { return false }
+
+func Start() error {
+	if Requested() {
+		return fmt.Errorf("Aegis owned mode is unavailable in this build")
+	}
+	return nil
+}
+
+func Listen(context.Context, net.IP, uint16) (net.Listener, error) {
+	return nil, fmt.Errorf("Aegis owned mode is unavailable in this build")
+}
diff --git a/main/aegis_owned.go b/main/aegis_owned.go
new file mode 100644
index 0000000000000000000000000000000000000000..de651c88e496dcf00f5baec16495f3fa596f205c
--- /dev/null
+++ b/main/aegis_owned.go
@@ -0,0 +1,88 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+
+	"github.com/xtls/xray-core/app/proxyman"
+	"github.com/xtls/xray-core/core"
+	"github.com/xtls/xray-core/infra/conf"
+	xhttp "github.com/xtls/xray-core/proxy/http"
+	"github.com/xtls/xray-core/proxy/socks"
+)
+
+// Accept only the JSON document that the browser writes on stdin.
+func loadAegisOwnedConfig() (*core.Config, error) {
+	if len(configFiles) != 1 || configFiles[0] != "stdin:" || configDir != "" ||
+		(*format != "auto" && *format != "json") {
+		return nil, fmt.Errorf("Aegis owned mode requires one explicit JSON stdin config")
+	}
+	const maxConfigBytes = 8192
+	input := &io.LimitedReader{R: os.Stdin, N: maxConfigBytes + 1}
+	decoder := json.NewDecoder(input)
+	decoder.DisallowUnknownFields()
+	var spec struct {
+		Log       *conf.LogConfig             `json:"log"`
+		Inbounds  []conf.InboundDetourConfig  `json:"inbounds"`
+		Outbounds []conf.OutboundDetourConfig `json:"outbounds"`
+	}
+	if err := decoder.Decode(&spec); err != nil {
+		return nil, fmt.Errorf("invalid Aegis owned config: %w", err)
+	}
+	if decoder.Decode(new(json.RawMessage)) != io.EOF || input.N == 0 {
+		return nil, fmt.Errorf("Aegis owned mode requires one bounded JSON document")
+	}
+	if len(spec.Outbounds) != 1 {
+		return nil, fmt.Errorf("Aegis owned mode requires one selected outbound")
+	}
+	c, err := (&conf.Config{
+		LogConfig: spec.Log, InboundConfigs: spec.Inbounds, OutboundConfigs: spec.Outbounds,
+	}).Build()
+	if err != nil {
+		return nil, err
+	}
+	if err := validateAegisOwnedInbound(c); err != nil {
+		return nil, err
+	}
+	return c, nil
+}
+
+func validateAegisOwnedInbound(config *core.Config) error {
+	if config == nil || len(config.Inbound) != 1 || config.Inbound[0] == nil ||
+		config.Inbound[0].ReceiverSettings == nil ||
+		config.Inbound[0].ProxySettings == nil {
+		return fmt.Errorf("Aegis owned mode requires exactly one configured inbound")
+	}
+	inbound := config.Inbound[0]
+	rawReceiver, err := inbound.ReceiverSettings.GetInstance()
+	if err != nil {
+		return err
+	}
+	receiver, ok := rawReceiver.(*proxyman.ReceiverConfig)
+	if !ok || receiver.Listen == nil || receiver.Listen.AsAddress() == nil ||
+		receiver.Listen.AsAddress().String() != "127.0.0.1" ||
+		receiver.StreamSettings != nil || receiver.ReceiveOriginalDestination {
+		return fmt.Errorf("Aegis owned mode requires a plain IPv4 loopback TCP inbound")
+	}
+	ports := receiver.GetPortList().GetRange()
+	if len(ports) != 1 || ports[0] == nil || ports[0].From != ports[0].To || ports[0].From > 65535 {
+		return fmt.Errorf("Aegis owned mode requires a single port")
+	}
+	settings, err := inbound.ProxySettings.GetInstance()
+	if err != nil {
+		return err
+	}
+	switch proxy := settings.(type) {
+	case *xhttp.ServerConfig:
+		if len(proxy.Accounts) == 0 {
+			return nil
+		}
+	case *socks.ServerConfig:
+		if proxy.AuthType == socks.AuthType_NO_AUTH && !proxy.UdpEnabled && len(proxy.Accounts) == 0 {
+			return nil
+		}
+	}
+	return fmt.Errorf("Aegis owned mode requires no-auth HTTP or TCP-only no-auth SOCKS5")
+}
