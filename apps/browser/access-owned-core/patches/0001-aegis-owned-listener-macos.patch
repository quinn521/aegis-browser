--- /dev/null
+++ b/internal/aegisowned/owned_default.go
@@ -0,0 +1,26 @@
+//go:build !darwin || !aegis_owned
+
+package aegisowned
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"os"
+)
+
+func Enabled() bool { return false }
+func Ready() bool   { return false }
+
+func Start() error {
+	_, parent := os.LookupEnv("AEGIS_OWNED_PARENT_PID")
+	_, lease := os.LookupEnv("AEGIS_OWNED_LISTENER_LEASE_FD")
+	if parent || lease {
+		return fmt.Errorf("Aegis owned mode is unavailable in this build")
+	}
+	return nil
+}
+
+func Listen(context.Context, net.IP, uint16) (net.Listener, error) {
+	return nil, fmt.Errorf("Aegis owned mode is unavailable in this build")
+}
