diff --git a/internal/aegisowned/launch.go b/internal/aegisowned/launch.go
new file mode 100644
index 0000000000000000000000000000000000000000..f03393e1c7c5de5486d79da73c5cac04b5c13861
--- /dev/null
+++ b/internal/aegisowned/launch.go
@@ -0,0 +1,17 @@
+package aegisowned
+
+import "os"
+
+const (
+	parentEnv = "AEGIS_OWNED_PARENT_PID"
+	leaseEnv  = "AEGIS_OWNED_LISTENER_LEASE_FD"
+)
+
+var requested = func() bool {
+	_, parent := os.LookupEnv(parentEnv)
+	_, lease := os.LookupEnv(leaseEnv)
+	return parent || lease
+}()
+
+// Requested reports launch intent even before the parent and lease are validated.
+func Requested() bool { return requested }
diff --git a/internal/aegisowned/owned_darwin.go b/internal/aegisowned/owned_darwin.go
new file mode 100644
index 0000000000000000000000000000000000000000..98be6f2ffe11992c02c87c3b03c7e46d82c7b9a2
--- /dev/null
+++ b/internal/aegisowned/owned_darwin.go
@@ -0,0 +1,137 @@
+//go:build darwin && aegis_owned
+
+// Package aegisowned implements the local macOS Aegis parent/listener contract.
+package aegisowned
+
+import (
+	"context"
+	"fmt"
+	"net"
+	"os"
+	"strconv"
+	"sync/atomic"
+
+	"golang.org/x/sys/unix"
+)
+
+const (
+	leaseFD  = 3
+	loopback = "127.0.0.1"
+)
+
+var (
+	enabled bool
+	bound   atomic.Bool
+	leased  atomic.Bool
+)
+
+func Enabled() bool { return enabled }
+func Ready() bool   { return leased.Load() }
+
+// Start must run before configuration loading and starting any workers.
+func Start() error {
+	if !Requested() {
+		return nil
+	}
+	parent, err := strconv.Atoi(os.Getenv(parentEnv))
+	if err != nil || parent <= 1 || parent != os.Getppid() || os.Getenv(leaseEnv) != "3" {
+		return fmt.Errorf("invalid Aegis parent identity or lease descriptor")
+	}
+	peer, err := unix.Getpeername(leaseFD)
+	if _, ok := peer.(*unix.SockaddrUnix); err != nil || !ok {
+		return fmt.Errorf("Aegis lease descriptor is not a connected Unix socket")
+	}
+	socketType, err := unix.GetsockoptInt(leaseFD, unix.SOL_SOCKET, unix.SO_TYPE)
+	if err != nil || socketType != unix.SOCK_STREAM {
+		return fmt.Errorf("Aegis lease descriptor is not a stream socket")
+	}
+	peerPID, err := unix.GetsockoptInt(leaseFD, unix.SOL_LOCAL, unix.LOCAL_PEERPID)
+	if err != nil || peerPID != parent {
+		return fmt.Errorf("Aegis lease peer does not match the parent")
+	}
+	unix.CloseOnExec(leaseFD)
+	if err := unix.SetsockoptInt(leaseFD, unix.SOL_SOCKET, unix.SO_NOSIGPIPE, 1); err != nil {
+		return fmt.Errorf("set Aegis lease socket options: %w", err)
+	}
+	queue, err := unix.Kqueue()
+	if err != nil {
+		return fmt.Errorf("create Aegis parent watcher: %w", err)
+	}
+	unix.CloseOnExec(queue)
+	change := []unix.Kevent_t{{
+		Ident: uint64(parent), Filter: unix.EVFILT_PROC,
+		Flags: unix.EV_ADD | unix.EV_ONESHOT, Fflags: unix.NOTE_EXIT,
+	}}
+	_, err = unix.Kevent(queue, change, nil, nil)
+	if err != nil || os.Getppid() != parent {
+		unix.Close(queue)
+		return fmt.Errorf("cannot watch the Aegis parent")
+	}
+	enabled = true
+	go watchParent(queue)
+	return nil
+}
+
+func watchParent(queue int) {
+	var events [1]unix.Kevent_t
+	for {
+		count, err := unix.Kevent(queue, nil, events[:], nil)
+		if err == unix.EINTR {
+			continue
+		}
+		if err != nil || count != 1 || events[0].Flags&unix.EV_ERROR != 0 {
+			os.Exit(23)
+		}
+		os.Exit(0)
+	}
+}
+
+// Listen creates exactly one exclusive IPv4 loopback socket and sends the
+// parent a duplicate of that listening FD. Port zero is allocated by macOS.
+func Listen(ctx context.Context, ip net.IP, port uint16) (net.Listener, error) {
+	if !enabled || !ip.Equal(net.IPv4(127, 0, 0, 1)) || !bound.CompareAndSwap(false, true) {
+		return nil, fmt.Errorf("Aegis owned mode requires one IPv4 loopback TCP listener")
+	}
+	defer unix.Close(leaseFD)
+	config := net.ListenConfig{KeepAlive: -1}
+	config.SetMultipathTCP(false)
+	listener, err := config.Listen(ctx, "tcp4", net.JoinHostPort(loopback, strconv.Itoa(int(port))))
+	if err != nil {
+		return nil, err
+	}
+	tcp, ok := listener.(*net.TCPListener)
+	if !ok {
+		listener.Close()
+		return nil, fmt.Errorf("unexpected Aegis listener type")
+	}
+	if err := publish(tcp); err != nil {
+		listener.Close()
+		return nil, err
+	}
+	leased.Store(true)
+	return tcp, nil
+}
+
+func publish(listener *net.TCPListener) error {
+	raw, err := listener.SyscallConn()
+	if err != nil {
+		return err
+	}
+	var sendError error
+	if err := raw.Control(func(fd uintptr) {
+		reuse, err := unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_REUSEPORT)
+		if err != nil || reuse != 0 {
+			sendError = fmt.Errorf("Aegis listener is not exclusive")
+			return
+		}
+		count, err := unix.SendmsgN(leaseFD, []byte{1}, unix.UnixRights(int(fd)), nil, unix.MSG_DONTWAIT)
+		if err != nil {
+			sendError = fmt.Errorf("send Aegis listener lease: %w", err)
+		} else if count != 1 {
+			sendError = fmt.Errorf("incomplete Aegis listener lease")
+		}
+	}); err != nil {
+		return err
+	}
+	return sendError
+}
