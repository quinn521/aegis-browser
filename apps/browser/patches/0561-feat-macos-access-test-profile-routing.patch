+.field-grid { display: grid;
+ grid-template-columns: 1fr 1fr;
+ gap: 16px;
+ margin-block-start: 18px; }
+
+#fixed-port-field { margin-block-start: 16px; }
+
+#inbound-port { max-inline-size: 160px;
+ font-variant-numeric: tabular-nums; }
+
+.local-note { margin-block-start: 16px; }
+
+.apply-bar { border-block-start: 1px solid var(--line);
+ padding: 18px 24px;
+ display: grid;
+ gap: 18px; }
+
+.apply-actions { display: flex;
+ justify-content: flex-end;
+ gap: 10px; }
+
+.primary:enabled { background: var(--accent);
+ border-color: var(--accent);
+ color: var(--surface); }
+
+.connection { padding: 20px 0; }
+
+.connection h3 { margin-block-end: 12px; }
+
+.connection-state { display: flex;
+ align-items: center;
+ gap: 8px;
+ font-size: 16px;
+ margin: 0 0 8px; }
+
+.connection-state::before { content: '';
+ inline-size: 7px;
+ block-size: 7px;
+ border-radius: 50%;
+ background: var(--muted);
+ flex: none; }
+
+.connection-state[data-state='active']::before,
+ .connection-state[data-state='prepared']::before { background: var(--success); }
+
+.connection-actions { display: flex;
+ flex-wrap: wrap;
+ gap: 8px; }
+
+.connection table { inline-size: 100%;
+ table-layout: fixed;
+ border-collapse: collapse;
+ margin: 16px 0; }
+
+.connection th,
+.connection td { padding-block: 8px;
+ text-align: start;
+ vertical-align: top;
+ overflow-wrap: anywhere; }
+
+.connection th { inline-size: 36%;
+ padding-inline-end: 8px;
+ font-size: 12px;
+ font-weight: normal;
+ color: var(--muted); }
+
+.connection td {
+ font-variant-numeric: tabular-nums; }
+
+.protection-note { margin: 0;
+ padding-block-start: 18px;
+ border-block-start: 1px solid var(--line);
+ color: var(--muted);
+ font-size: 12px; }
+@media (max-width: 760px) {
+  .workspace { grid-template-columns: 1fr;
+ gap: 0; }
+  .connection { padding: 26px 0 0; }
+  .page-header { padding: 14px 16px;
+ flex-wrap: wrap;
+ gap: 8px; }
+  .channel { margin-inline-start: 0; }
+  main { padding: 24px 16px; }
+}
+@media (max-width: 420px) {
+  .field-grid { grid-template-columns: 1fr; }
+  fieldset { padding-inline: 18px; }
+  .apply-bar { padding-inline: 18px; }
+  .input-actions > * { flex-grow: 1;
+ justify-content: center; }
+}
