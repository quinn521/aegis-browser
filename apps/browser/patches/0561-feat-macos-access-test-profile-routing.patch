+  void HoldRevokedLegacyRollback(const AccessSiteHost& host,
+                                 const std::string& registration) {
+    auto* options = AccessOptionsService::GetOrCreate(profile_.get());
+    ASSERT_NO_FATAL_FAILURE(PrepareExplicitly(options));
