@@ -0,0 +1,52 @@
+// Copyright 2026 GCSA
+#include "components/aegis_access/access_inbound_preferences.h"
+
+namespace aegis_access {
+
+AccessInboundProtocolPreference ParseAccessInboundProtocolPreference(
+    std::string_view value) {
+  if (value == "auto") return AccessInboundProtocolPreference::kAuto;
+  if (value == "http") return AccessInboundProtocolPreference::kHttp;
+  if (value == "socks5") return AccessInboundProtocolPreference::kSocks5;
+  return AccessInboundProtocolPreference::kInvalid;
+}
+
+AccessInboundPortMode ParseAccessInboundPortMode(std::string_view value) {
+  if (value == "random") return AccessInboundPortMode::kSystemAllocated;
+  if (value == "fixed") return AccessInboundPortMode::kInternalFixed;
+  return AccessInboundPortMode::kInvalid;
+}
+
+std::optional<uint16_t> ParseAccessInboundFixedPort(std::string_view value) {
+  if (value.empty() || value.size() > 5) return std::nullopt;
+  uint32_t port = 0;
+  for (const char digit : value) {
+    if (digit < '0' || digit > '9') return std::nullopt;
+    port = port * 10 + static_cast<uint32_t>(digit - '0');
+  }
+  if (port == 0 || port > 65535) return std::nullopt;
+  return static_cast<uint16_t>(port);
+}
+
+AccessInboundPreferenceError ValidateAccessInboundPreferences(
+    const AccessInboundPreferences& preferences) {
+  using Error = AccessInboundPreferenceError;
+  using Protocol = AccessInboundProtocolPreference;
+  using Mode = AccessInboundPortMode;
+  if (preferences.protocol != Protocol::kAuto &&
+      preferences.protocol != Protocol::kHttp &&
+      preferences.protocol != Protocol::kSocks5) return Error::kInvalidProtocol;
+  if (preferences.port_mode == Mode::kSystemAllocated) {
+    return preferences.requested_port == 0 ? Error::kNone
+                                          : Error::kUnexpectedRequestedPort;
+  }
+  if (preferences.port_mode != Mode::kInternalFixed) return Error::kInvalidPortMode;
+  if (preferences.requested_port == 0 || preferences.requested_port > 65535)
+    return Error::kPortOutOfRange;
+  if (preferences.protocol != Protocol::kHttp &&
+      preferences.requested_port != kAccessInternalFixedSocks5Port)
+    return Error::kFixedSocksPortNotAllowed;
+  return Error::kNone;
+}
+
+}  // namespace aegis_access
diff --git a/components/aegis_access/access_inbound_preferences.h b/components/aegis_access/access_inbound_preferences.h
new file mode 100644
index 0000000000000000000000000000000000000000..f94d9d95ed3bc8a7a63f402a47f265326563eb5c
--- /dev/null
+++ b/components/aegis_access/access_inbound_preferences.h
@@ -0,0 +1,60 @@
+// Copyright 2026 GCSA
+#ifndef COMPONENTS_AEGIS_ACCESS_ACCESS_INBOUND_PREFERENCES_H_
+#define COMPONENTS_AEGIS_ACCESS_ACCESS_INBOUND_PREFERENCES_H_
+
+#include <cstdint>
+#include <optional>
+#include <string_view>
+
+namespace aegis_access {
+
+enum class AccessInboundProtocolPreference {
+  kInvalid,
+  kAuto,
+  kHttp,
+  kSocks5,
+};
+
+enum class AccessInboundPortMode {
+  kInvalid,
+  kSystemAllocated,
+  kInternalFixed,
+};
+
+inline constexpr uint16_t kAccessInternalFixedSocks5Port = 10806;
+
+// Application-owned loopback preferences, independent of upstream node ports.
+// Zero requests the OS allocation only; it is never a registered actual port.
+// These defaults do not enable a platform/channel or grant runtime admission.
+struct AccessInboundPreferences {
+  AccessInboundProtocolPreference protocol = AccessInboundProtocolPreference::kAuto;
+  AccessInboundPortMode port_mode = AccessInboundPortMode::kSystemAllocated;
+  uint32_t requested_port = 0;
+  bool operator==(const AccessInboundPreferences&) const = default;
+};
+
+enum class AccessInboundPreferenceError {
+  kNone,
+  kInvalidProtocol,
+  kInvalidPortMode,
+  kUnexpectedRequestedPort,
+  kPortOutOfRange,
+  kFixedSocksPortNotAllowed,
+};
+
+AccessInboundProtocolPreference ParseAccessInboundProtocolPreference(
+    std::string_view value);
+AccessInboundPortMode ParseAccessInboundPortMode(std::string_view value);
+// One to five ASCII decimal digits, value 1..65535. No sign, whitespace,
+// floating point, exponent or implicit truncation from a wider integer.
+std::optional<uint16_t> ParseAccessInboundFixedPort(std::string_view value);
+
+// Validates intent only. The native channel, authorization, owned listener,
+// actual nonzero port, protocol readiness and exact publication ACK remain
+// separate requirements. This never launches, binds, selects a fallback or
+// changes an existing route; local authentication is not a preference field.
+AccessInboundPreferenceError ValidateAccessInboundPreferences(
+    const AccessInboundPreferences& preferences);
+
+}  // namespace aegis_access
+#endif  // COMPONENTS_AEGIS_ACCESS_ACCESS_INBOUND_PREFERENCES_H_
diff --git a/components/aegis_access/access_inbound_preferences_test.cc b/components/aegis_access/access_inbound_preferences_test.cc
new file mode 100644
index 0000000000000000000000000000000000000000..84f5b982bdb062a5b17f8020f0807fe53a26c9a8
--- /dev/null
+++ b/components/aegis_access/access_inbound_preferences_test.cc
@@ -0,0 +1,65 @@
+// Copyright 2026 GCSA
+#include "components/aegis_access/access_inbound_preferences.h"
+
+#include <array>
+#include <cassert>
+#include <iostream>
+#include <limits>
+#include <utility>
+
+int main() {
+  using namespace aegis_access;
+  using Protocol = AccessInboundProtocolPreference;
+  using Mode = AccessInboundPortMode;
+  using Error = AccessInboundPreferenceError;
+  assert(ValidateAccessInboundPreferences({}) == Error::kNone);
+  for (auto protocol : {Protocol::kAuto, Protocol::kHttp, Protocol::kSocks5}) {
+    assert(ValidateAccessInboundPreferences({protocol, Mode::kSystemAllocated, 0}) == Error::kNone);
+    for (uint32_t stale_port : {1u, 1080u, 10806u, 65535u}) {
+      assert(ValidateAccessInboundPreferences({protocol, Mode::kSystemAllocated, stale_port}) ==
+             Error::kUnexpectedRequestedPort);
+    }
+    assert(ValidateAccessInboundPreferences({protocol, Mode::kInternalFixed, 10806}) == Error::kNone);
+    for (uint32_t invalid : {0u, 65536u, std::numeric_limits<uint32_t>::max()}) {
+      assert(ValidateAccessInboundPreferences({protocol, Mode::kInternalFixed, invalid}) ==
+             Error::kPortOutOfRange);
+    }
+  }
+  for (auto protocol : {Protocol::kAuto, Protocol::kSocks5}) {
+    for (uint32_t forbidden_fixed : {1u, 1080u, 8080u, 65535u}) {
+      assert(ValidateAccessInboundPreferences({protocol, Mode::kInternalFixed, forbidden_fixed}) ==
+             Error::kFixedSocksPortNotAllowed);
+    }
+  }
+  for (uint32_t http_port : {1u, 1080u, 8080u, 10806u, 65535u}) {
+    assert(ValidateAccessInboundPreferences({Protocol::kHttp, Mode::kInternalFixed, http_port}) ==
+           Error::kNone);
+  }
+  assert(ValidateAccessInboundPreferences({Protocol::kInvalid}) == Error::kInvalidProtocol);
+  assert(ValidateAccessInboundPreferences({static_cast<Protocol>(255)}) == Error::kInvalidProtocol);
+  assert(ValidateAccessInboundPreferences({Protocol::kHttp, Mode::kInvalid}) == Error::kInvalidPortMode);
+  assert(ValidateAccessInboundPreferences({Protocol::kHttp, static_cast<Mode>(255)}) == Error::kInvalidPortMode);
+  assert(ParseAccessInboundProtocolPreference("auto") == Protocol::kAuto);
+  assert(ParseAccessInboundProtocolPreference("http") == Protocol::kHttp);
+  assert(ParseAccessInboundProtocolPreference("socks5") == Protocol::kSocks5);
+  for (auto invalid : {"", "HTTP", "socks", "direct", "http ", "https"}) {
+    assert(ParseAccessInboundProtocolPreference(invalid) == Protocol::kInvalid);
+  }
+  assert(ParseAccessInboundPortMode("random") == Mode::kSystemAllocated);
+  assert(ParseAccessInboundPortMode("fixed") == Mode::kInternalFixed);
+  for (auto invalid : {"", "auto", "RANDOM", "fixed "}) {
+    assert(ParseAccessInboundPortMode(invalid) == Mode::kInvalid);
+  }
+  for (const auto& [text, expected] : std::array<std::pair<std::string_view, uint16_t>, 7>{{
+           {"1", 1}, {"80", 80}, {"1080", 1080}, {"8080", 8080},
+           {"10806", 10806}, {"65535", 65535}, {"00001", 1}}}) {
+    assert(ParseAccessInboundFixedPort(text) == expected);
+  }
+  for (auto invalid : {"", "0", "00000", "65536", "99999", "1e3", "1.0",
+                       "-1", "+80", " 80", "80 ", "80\n", "80\r", "000080", "٨٠"}) {
+    assert(!ParseAccessInboundFixedPort(invalid));
+  }
+  constexpr char embedded_nul[] = {'8', '0', '\0'};
+  assert(!ParseAccessInboundFixedPort(std::string_view(embedded_nul, sizeof(embedded_nul))));
+  std::cout << "PASS: local inbound preference and decimal port contracts\n";
+}
diff --git a/components/aegis_access/access_inbound_preferences_unittest.cc b/components/aegis_access/access_inbound_preferences_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..8b00224e1b91bdfacf0206da0f55076d85e77cf0
--- /dev/null
+++ b/components/aegis_access/access_inbound_preferences_unittest.cc
@@ -0,0 +1,47 @@
+// Copyright 2026 GCSA
+#include "components/aegis_access/access_inbound_preferences.h"
+
+#include <limits>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aegis_access {
+namespace {
+using Protocol = AccessInboundProtocolPreference;
+using Mode = AccessInboundPortMode;
+using Error = AccessInboundPreferenceError;
+
+TEST(AccessInboundPreferencesTest, RandomHasNoSavedActualPortAndFixedSocksIs10806Only) {
+  EXPECT_EQ(ValidateAccessInboundPreferences({}), Error::kNone);
+  for (auto protocol : {Protocol::kAuto, Protocol::kHttp, Protocol::kSocks5}) {
+    EXPECT_EQ(ValidateAccessInboundPreferences({protocol, Mode::kSystemAllocated, 0}), Error::kNone);
+    EXPECT_EQ(ValidateAccessInboundPreferences({protocol, Mode::kSystemAllocated, 10806}),
+              Error::kUnexpectedRequestedPort);
+    EXPECT_EQ(ValidateAccessInboundPreferences({protocol, Mode::kInternalFixed, 10806}), Error::kNone);
+    for (uint32_t invalid : {0u, 65536u, std::numeric_limits<uint32_t>::max()})
+      EXPECT_EQ(ValidateAccessInboundPreferences({protocol, Mode::kInternalFixed, invalid}), Error::kPortOutOfRange);
+  }
+  for (auto protocol : {Protocol::kAuto, Protocol::kSocks5}) {
+    for (uint32_t forbidden : {1u, 1080u, 8080u, 65535u})
+      EXPECT_EQ(ValidateAccessInboundPreferences({protocol, Mode::kInternalFixed, forbidden}),
+                Error::kFixedSocksPortNotAllowed);
+  }
+  for (uint32_t port : {1u, 1080u, 8080u, 10806u, 65535u})
+    EXPECT_EQ(ValidateAccessInboundPreferences({Protocol::kHttp, Mode::kInternalFixed, port}), Error::kNone);
+}
+
+TEST(AccessInboundPreferencesTest, RejectsUnknownEnumsAndNonDecimalOrOutOfRangePorts) {
+  EXPECT_EQ(ValidateAccessInboundPreferences({static_cast<Protocol>(255)}), Error::kInvalidProtocol);
+  EXPECT_EQ(ValidateAccessInboundPreferences({Protocol::kHttp, static_cast<Mode>(255)}), Error::kInvalidPortMode);
+  EXPECT_EQ(ParseAccessInboundFixedPort("1"), 1u);
+  EXPECT_EQ(ParseAccessInboundFixedPort("00001"), 1u);
+  EXPECT_EQ(ParseAccessInboundFixedPort("10806"), 10806u);
+  EXPECT_EQ(ParseAccessInboundFixedPort("65535"), 65535u);
+  for (const auto invalid : {"", "0", "65536", "99999", "1e3", "1.0", "-1",
+                            "+80", " 80", "80 ", "80\n", "000080", "٨٠"})
+    EXPECT_FALSE(ParseAccessInboundFixedPort(invalid));
+  constexpr char embedded_nul[] = {'8', '0', '\0'};
+  EXPECT_FALSE(ParseAccessInboundFixedPort(std::string_view(embedded_nul, sizeof(embedded_nul))));
