+std::optional<std::string> AccessOptionsService::BeginTestNodeEditor() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!CanPreviewTestNode() || editors_.size() >= 16) return std::nullopt;
