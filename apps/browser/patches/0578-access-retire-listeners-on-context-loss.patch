diff --git a/chrome/browser/aegis/access/access_private_context_client.cc b/chrome/browser/aegis/access/access_private_context_client.cc
index edc3d3e2bd81cecc479ea010cca242502c1bc8c2..b2a965ac4b2ffdd08742d41b4562124b543c2b91 100644
--- a/chrome/browser/aegis/access/access_private_context_client.cc
+++ b/chrome/browser/aegis/access/access_private_context_client.cc
@@ -359,11 +359,19 @@ void AccessPrivateContextClient::CreateFactory(
   context_->CreateFactory(std::move(receiver), std::move(params), std::move(binding),
       mojo::WrapCallbackWithDefaultInvokeIfNotRun(std::move(reply), false));
 }
+void AccessPrivateContextClient::SetDisconnectHandler(base::OnceClosure handler) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(connected_ && !on_disconnect_);
+  on_disconnect_ = std::move(handler);
+}
+
 void AccessPrivateContextClient::OnDisconnect() {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
   connected_ = ready_ = publication_pending_ = false;
   incarnation_.clear();
   ++operation_;
+  auto notify = std::move(on_disconnect_);
   if (reject_initialize_) std::move(reject_initialize_).Run();
+  if (notify) std::move(notify).Run();
 }
 }  // namespace aegis::access
