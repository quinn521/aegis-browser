diff --git a/chrome/browser/aegis/access/access_browser_request_adapter_browsertest.cc b/chrome/browser/aegis/access/access_browser_request_adapter_browsertest.cc
--- a/chrome/browser/aegis/access/access_browser_request_adapter_browsertest.cc
+++ b/chrome/browser/aegis/access/access_browser_request_adapter_browsertest.cc
@@ -14,6 +14,7 @@
 #include "content/public/browser/render_frame_host.h"
 #include "content/public/browser/web_contents.h"
 #include "content/public/test/prerender_test_util.h"
