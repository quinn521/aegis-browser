+  const auto* users = servers->front().GetDict().FindList("users");
+  ASSERT_TRUE(users);
+  ASSERT_EQ(users->size(), 1u);
+  const auto* flow = users->front().GetDict().FindString("flow");
+  ASSERT_TRUE(flow);
+  EXPECT_EQ(*flow, "xtls-rprx-vision");
