+    }
+    const auto scheme = text.substr(start, colon - start);
+    if (!std::ranges::any_of(scheme, [](char c) {
+          return LowerAscii(c) >= 'a' && LowerAscii(c) <= 'z';
+        })) {
+      continue;
+    }
+    if (!std::ranges::equal(scheme, std::string_view("https"), {},
+                            LowerAscii) &&
