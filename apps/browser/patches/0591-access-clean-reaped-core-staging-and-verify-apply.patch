Date: Fri, 27 Nov 2026 12:55:01 +0800
Subject: [PATCH] fix(access): clean reaped core staging before Network
 retirement

---
 ...cess_internal_core_manager_mac_unittest.cc |  26 +++
 .../aegis/access/access_local_core_manager.cc |   6 +-
 .../access/access_options_browsertest.cc      | 156 ++++++++++++++++--
 3 files changed, 171 insertions(+), 17 deletions(-)

diff --git a/chrome/browser/aegis/access/access_internal_core_manager_mac_unittest.cc b/chrome/browser/aegis/access/access_internal_core_manager_mac_unittest.cc
index 5f346e50f2d40bbd5b05b8b3eef4a2503fd430af..5daf02a858c91a966d68d29a4d7f01631aaace77 100644
--- a/chrome/browser/aegis/access/access_internal_core_manager_mac_unittest.cc
+++ b/chrome/browser/aegis/access/access_internal_core_manager_mac_unittest.cc
@@ -12,6 +12,9 @@
 #include "base/files/file_util.h"
 #include "base/files/scoped_file.h"
 #include "base/json/json_writer.h"
+#include "base/no_destructor.h"
+#include "base/process/process_handle.h"
+#include "base/synchronization/lock.h"
 #include "base/strings/string_number_conversions.h"
 #include "base/synchronization/waitable_event.h"
 #include "base/task/execution_fence.h"
@@ -32,8 +35,23 @@ namespace {
 std::atomic_bool block_retirement{false};
 std::atomic<pid_t> retirement_pid{0};
 std::atomic<uint16_t> retirement_port{0};
+struct RetiringExecutable {
+  base::Lock lock;
+  base::FilePath path GUARDED_BY(lock);
+};
+
+RetiringExecutable& GetRetiringExecutable() {
+  static base::NoDestructor<RetiringExecutable> executable;
+  return *executable;
+}
+
 AccessOwnedChildRetirementMac RetirementFault(const AccessOwnedChildMac& child, uint32_t wait) {
   retirement_pid.store(child.pid());
+  {
+    auto& executable = GetRetiringExecutable();
+    base::AutoLock lock(executable.lock);
+    executable.path = base::GetProcessExecutablePath(child.pid());
+  }
   if (const auto inspected = InspectAccessOwnedListenerMac(child); inspected.proof)
     retirement_port.store(inspected.proof->port);
   return block_retirement.load() ? AccessOwnedChildRetirementMac::kDeadlineExceeded
@@ -289,6 +307,14 @@ TEST_F(AccessInternalCoreManagerMacTest,
       stopped));
   base::ScopedAllowBaseSyncPrimitivesForTesting allow_wait;
   EXPECT_TRUE(stopped->TimedWait(base::Seconds(5)));
+  base::FilePath staged_executable;
+  {
+    auto& executable = GetRetiringExecutable();
+    base::AutoLock lock(executable.lock);
+    staged_executable = executable.path;
+  }
+  ASSERT_EQ(staged_executable.BaseName().value(), "xray");
+  EXPECT_FALSE(base::PathExists(staged_executable.DirName()));
   EXPECT_TRUE(LoopbackPortHeld(port));
   EXPECT_TRUE(vault_->IsRuntimeReferenced(input_.internal_test_profile->reference));
 }
diff --git a/chrome/browser/aegis/access/access_local_core_manager.cc b/chrome/browser/aegis/access/access_local_core_manager.cc
index e04dc2296760f494b20142491d9351ff8ea39bf2..6655c13711d57270e4e29e7af578a7f4104acbdf 100644
--- a/chrome/browser/aegis/access/access_local_core_manager.cc
+++ b/chrome/browser/aegis/access/access_local_core_manager.cc
@@ -1041,6 +1041,10 @@ class AccessLocalCoreManager::Worker : public net::URLRequest::Delegate {
     credentials_.reset();
     authenticated_ = false;
 #if BUILDFLAG(IS_MAC)
+    // Once the child is reaped, its private staging directory has no
+    // consumers. The published listener and Vault reference still have them.
+    const bool stage_deleted =
+        !IsInternal() || !directory_.IsValid() || directory_.Delete();
     if (IsInternal() && network_lease_pending_ && !consumers_revoked) {
       // The child is reaped; only the published address remains held.
       return false;
@@ -1053,7 +1057,7 @@ class AccessLocalCoreManager::Worker : public net::URLRequest::Delegate {
     if (IsInternal()) {
       port_ = 0;
       registration_.clear();
-      if (directory_.IsValid() && !directory_.Delete()) return false;
+      if (!stage_deleted) return false;
       if (release_reference) runtime_reference_lease_.reset();
     } else {
       const bool deleted = directory_.Delete();
diff --git a/chrome/browser/aegis/access/access_options_browsertest.cc b/chrome/browser/aegis/access/access_options_browsertest.cc
index ed78487d3b2c554fdff0d541ea614024666f5821..e4622e45e8eac3e3b753654ebeced4fbd3063a39 100644
