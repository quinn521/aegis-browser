From 93eedc23e5890ebcb8cbf8141e9d76981ab8853e Mon Sep 17 00:00:00 2001
From: quinn521 <287940781+quinn521@users.noreply.github.com>
Date: Sat, 28 Nov 2026 18:47:26 +0800
Subject: [PATCH] test(access): cover all four shared VLESS import profiles

Track gcsagroup/aegis-browser#252.
---
 components/aegis_access/access_test_node_test.cc | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/components/aegis_access/access_test_node_test.cc b/components/aegis_access/access_test_node_test.cc
index c88957c11a8247b3a2574962dbc9239a50155a4a..b929f464566b455434b2b436704794586fa5e652 100644
--- a/components/aegis_access/access_test_node_test.cc
+++ b/components/aegis_access/access_test_node_test.cc
@@ -179,10 +179,14 @@ int main() {
   for (const auto& [profile, share] : aegis_access::test::kSharedShareLinks) {
     const auto parsed = ParseAccessTestNodeShare(share, kExtended);
     const bool expected_ws = profile == "vless.ws.tls";
+    const bool expected_tcp_tls = profile == "vless.raw.tls";
+    const bool expected_grpc = profile == "vless.grpc.reality";
     if (!parsed.node ||
-        (profile != "vless.raw.reality" && !expected_ws) ||
+        (profile != "vless.raw.reality" && !expected_ws && !expected_tcp_tls &&
+         !expected_grpc) ||
         parsed.node->web_socket_tls.has_value() != expected_ws ||
-        parsed.node->tcp_tls_vision || parsed.node->grpc_reality_service_name) {
+        parsed.node->tcp_tls_vision != expected_tcp_tls ||
+        parsed.node->grpc_reality_service_name.has_value() != expected_grpc) {
       std::cerr << "Shared fixture did not produce its expected profile: "
                 << profile << '\n';
       return 1;
