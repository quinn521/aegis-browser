+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -401,6 +401,7 @@
 #include "media/mojo/mojom/speech_recognizer.mojom.h"
 #include "mojo/public/cpp/bindings/remote.h"
 #include "net/base/data_url.h"
+#include "net/base/net_errors.h"
 #include "net/base/url_util.h"
 #include "net/cookies/cookie_setting_override.h"
 #include "net/cookies/site_for_cookies.h"
@@ -6843,6 +6844,10 @@
 
 bool ChromeContentBrowserClient::WillInterceptWebSocket(
     content::RenderFrameHost* frame) {
+  if (aegis::access::AccessProxyingURLLoaderFactory::
+          ShouldInterceptFrameWebSocket(frame)) {
+    return true;
+  }
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
   if (!frame) {
     return false;
@@ -6888,21 +6893,61 @@
     mojo::PendingRemote<network::mojom::WebSocketHandshakeClient>
         handshake_client,
     content::ContentBrowserClient::WebSocketOptions options) {
+  Profile* profile =
+      frame ? Profile::FromBrowserContext(frame->GetBrowserContext()) : nullptr;
+  if (aegis::access::AccessProxyingURLLoaderFactory::
+          ShouldInterceptFrameWebSocket(frame)) {
+    const aegis::access::AccessFrameWebSocketGateResult gate =
+        aegis::access::AccessProxyingURLLoaderFactory::
+            EvaluateFrameWebSocketForDispatch(profile, frame, url);
+    if (gate.disposition ==
+        aegis::access::AccessFrameWebSocketGateDisposition::kBlock) {
+      mojo::Remote<network::mojom::WebSocketHandshakeClient> client(
+          std::move(handshake_client));
+      if (client.is_bound()) {
+        client->OnFailure("Blocked by Aegis Access policy", gate.net_error,
+                          -1);
+      }
+      return;
+    }
+    if (gate.disposition ==
+        aegis::access::AccessFrameWebSocketGateDisposition::kDispatchProxy) {
+      if (!gate.ownership_record.has_value() ||
+          !aegis::access::AccessProxyingURLLoaderFactory::
+              CompleteFrameWebSocketDispatch(profile,
+                                              *gate.ownership_record)) {
+        mojo::Remote<network::mojom::WebSocketHandshakeClient> client(
+            std::move(handshake_client));
+        if (client.is_bound()) {
+          client->OnFailure("Aegis Access dispatch registration failed",
+                            net::ERR_PROXY_CONNECTION_FAILED, -1);
+        }
+        return;
+      }
+    }
+  }
+
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
-  // TODO(crbug.com/40195467): Request w/o a frame also should be proxied.
-  if (!frame) {
-    return;
-  }
-  auto* web_request_api =
-      extensions::BrowserContextKeyedAPIFactory<extensions::WebRequestAPI>::Get(
-          frame->GetBrowserContext());
-
-  DCHECK(web_request_api);
-  web_request_api->ProxyWebSocket(
-      frame, std::move(factory), url, site_for_cookies, user_agent,
-      std::move(handshake_client), std::move(options.header_client));
+  if (frame) {
+    auto* web_request_api =
+        extensions::BrowserContextKeyedAPIFactory<
+            extensions::WebRequestAPI>::Get(frame->GetBrowserContext());
+    if (web_request_api && web_request_api->MayHaveProxiesForFrame(frame)) {
+      web_request_api->ProxyWebSocket(
+          frame, std::move(factory), url, site_for_cookies, user_agent,
+          std::move(handshake_client), std::move(options.header_client));
+      return;
+    }
+  }
 #endif
+
+  std::vector<network::mojom::HttpHeaderPtr> additional_headers;
+  if (user_agent.has_value()) {
+    additional_headers.push_back(
+        network::mojom::HttpHeader::New("User-Agent", *user_agent));
+  }
+  std::move(factory).Run(url, std::move(additional_headers),
+                         std::move(handshake_client), mojo::NullRemote(),
+                         std::move(options.header_client));
 }
