From 7490d3bcdfe16e6b54ac6d5ffecf7751be4031bf Mon Sep 17 00:00:00 2001
From: Quinn <coderquinn@gmail.com>
Date: Wed, 25 Nov 2026 12:07:32 +0800
Subject: [PATCH] fix(access): reap an exact owned child that exited before
 retirement

proc_pidinfo reports ESRCH for an exited but unreaped child while its PID stays allocated. Retirement treated that as retired and never called waitpid, leaving a zombie. Confirm the exact child through sysctl (PID, start time, parent, SZOMB) and reap it; report identity unavailable when the parent or state is unclear.
---
 .../aegis/access/access_owned_listener_mac.cc | 25 +++++++++++-
 .../access_owned_listener_mac_unittest.cc     | 38 +++++++++++++++++++
 2 files changed, 62 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/aegis/access/access_owned_listener_mac.cc b/chrome/browser/aegis/access/access_owned_listener_mac.cc
index 3050206241031e5002ada884766c7f897da0811d..a40cb951e2e99e6c672aefa257411b3eba793558 100644
--- a/chrome/browser/aegis/access/access_owned_listener_mac.cc
+++ b/chrome/browser/aegis/access/access_owned_listener_mac.cc
@@ -9,6 +9,7 @@
 #include <signal.h>
 #include <sys/proc_info.h>
 #include <sys/socket.h>
+#include <sys/sysctl.h>
 #include <sys/wait.h>
 #include <unistd.h>
 
@@ -33,6 +34,28 @@ bool SameProcess(const AccessOwnedChildMac& child, const proc_bsdinfo& info) {
   return info.pbi_start_tvsec == child.start_seconds() &&
          info.pbi_start_tvusec == child.start_microseconds();
 }
+// proc_pidinfo reports ESRCH for a child that has exited but is not yet reaped,
+// while its PID stays allocated. sysctl still exposes the zombie's birth, parent
+// and state, so only the exact captured child is reaped here. Returns true once
+// the captured child no longer holds the PID, false while that exact child has
+// not reached the zombie state yet, and nullopt when its identity is unclear.
+std::optional<bool> ReapExactExitedChild(const AccessOwnedChildMac& child) {
+  kinfo_proc process{};
+  size_t length = sizeof(process);
+  int mib[4] = {CTL_KERN, KERN_PROC, KERN_PROC_PID, child.pid()};
+  if (sysctl(mib, 4, &process, &length, nullptr, 0) != 0) return std::nullopt;
+  if (length == 0) return true;  // The PID is fully released.
+  if (length != sizeof(process) || process.kp_proc.p_pid != child.pid())
+    return std::nullopt;
+  if (static_cast<uint64_t>(process.kp_proc.p_starttime.tv_sec) !=
+          static_cast<uint64_t>(child.start_seconds()) ||
+      static_cast<uint64_t>(process.kp_proc.p_starttime.tv_usec) !=
+          static_cast<uint64_t>(child.start_microseconds()))
+    return true;  // A different process now owns the PID.
+  if (process.kp_eproc.e_ppid != getpid()) return std::nullopt;
+  if (process.kp_proc.p_stat != SZOMB) return false;
+  return ReapAccessExitedChildMac(child.pid()) ? std::make_optional(true) : std::nullopt;
+}
 bool IsListener(const socket_fdinfo& info) {
   return info.psi.soi_kind == SOCKINFO_TCP &&
          info.psi.soi_proto.pri_tcp.tcpsi_state == TSI_S_LISTEN;
@@ -86,7 +109,7 @@ AccessOwnedChildRetirementMac RetireAccessOwnedChildMac(
     errno = 0;
     const auto size = proc_pidinfo(child.pid(), PROC_PIDTBSDINFO, 0, &info, sizeof(info));
     if (size != static_cast<int>(sizeof(info)))
-      return errno == ESRCH ? std::make_optional(true) : std::nullopt;
+      return errno == ESRCH ? ReapExactExitedChild(child) : std::nullopt;
     if (!SameProcess(child, info)) return true;
     if (info.pbi_pid != static_cast<uint32_t>(child.pid()) ||
         info.pbi_ppid != static_cast<uint32_t>(getpid()) || info.pbi_uid != geteuid())
diff --git a/chrome/browser/aegis/access/access_owned_listener_mac_unittest.cc b/chrome/browser/aegis/access/access_owned_listener_mac_unittest.cc
index 3ff052a76f76b401570636df1533d0cd0af4464f..a2c5527bd51f13f0749aab5b5e715c8ec15d8884 100644
--- a/chrome/browser/aegis/access/access_owned_listener_mac_unittest.cc
+++ b/chrome/browser/aegis/access/access_owned_listener_mac_unittest.cc
@@ -6,6 +6,7 @@
 #include <fcntl.h>
 #include <signal.h>
 #include <sys/socket.h>
+#include <sys/sysctl.h>
 #include <unistd.h>
 
 #include <cerrno>
@@ -129,6 +130,29 @@ AccessListenerLeaseResultMac WaitForLease(int channel, const AccessOwnedChildMac
   return result;
 }
 
+bool IsZombie(pid_t pid) {
+  kinfo_proc process{};
+  size_t length = sizeof(process);
+  int mib[4] = {CTL_KERN, KERN_PROC, KERN_PROC_PID, pid};
+  return sysctl(mib, 4, &process, &length, nullptr, 0) == 0 &&
+         length == sizeof(process) && process.kp_proc.p_stat == SZOMB;
+}
+
+bool WaitForZombie(pid_t pid) {
+  const auto deadline = base::TimeTicks::Now() + base::Seconds(5);
+  while (!IsZombie(pid)) {
+    if (base::TimeTicks::Now() >= deadline) return false;
+    base::PlatformThread::Sleep(base::Milliseconds(10));
+  }
+  return true;
+}
+
+// The PID stays allocated while an exited child is unreaped.
+bool PidReleased(pid_t pid) {
+  errno = 0;
+  return kill(pid, 0) == -1 && errno == ESRCH;
+}
+
 TEST(AccessOwnedListenerMacTest, SameOwnedSocketReportsDistinctSystemAssignedPortsAndRetiresIndependently) {
   ScopedListenerChild a("exclusive"), b("exclusive");
   const auto owned_a = CaptureAccessOwnedChildMac(a.pid());
@@ -219,6 +243,20 @@ TEST(AccessOwnedListenerMacTest, NormalRetirementConfirmsExitWithoutReapingDurin
   EXPECT_FALSE(ReapAccessExitedChildMac(child.pid()));
   EXPECT_EQ(child.Retire(*owned, 2000), AccessOwnedChildRetirementMac::kRetired);
   EXPECT_FALSE(AccessOwnedChildStillMatchesMac(*owned));
+  EXPECT_TRUE(PidReleased(owned->pid()));
+}
+
+TEST(AccessOwnedListenerMacTest, RetirementReapsExactChildThatAlreadyExitedUnreaped) {
+  ScopedListenerChild child("none");
+  const auto owned = CaptureAccessOwnedChildMac(child.pid());
+  ASSERT_TRUE(owned);
+  ASSERT_EQ(kill(owned->pid(), SIGUSR1), 0);
+  ASSERT_TRUE(WaitForZombie(owned->pid()));
+  EXPECT_FALSE(AccessOwnedChildStillMatchesMac(*owned));
+  EXPECT_FALSE(PidReleased(owned->pid()));
+  EXPECT_EQ(child.Retire(*owned, 2000), AccessOwnedChildRetirementMac::kRetired);
+  EXPECT_TRUE(PidReleased(owned->pid()));
+  EXPECT_EQ(RetireAccessOwnedChildMac(*owned, 2000), AccessOwnedChildRetirementMac::kRetired);
 }
 
 TEST(AccessOwnedListenerMacTest, DuplicatedKernelListenerReservesAddressAfterChildDeathUntilNativeRelease) {
