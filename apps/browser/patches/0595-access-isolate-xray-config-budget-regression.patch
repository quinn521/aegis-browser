From 822fa2d786259cd99733e067259f8bd97943113f Mon Sep 17 00:00:00 2001
From: Aegis desktop verification <aegis@gcsa.local>
Date: Fri, 27 Nov 2026 13:20:29 +0800
Subject: [PATCH] test(access): isolate the Xray stdin limit from the Vault
 limit

---
 .../browser/aegis/access/access_options_service_unittest.cc   | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/chrome/browser/aegis/access/access_options_service_unittest.cc b/chrome/browser/aegis/access/access_options_service_unittest.cc
index 393975f8ee8373e7a72673b7b00167ca8eeefb83..11fd6d905215c81f00d4de0abc2e364998bd4abc 100644
--- a/chrome/browser/aegis/access/access_options_service_unittest.cc
+++ b/chrome/browser/aegis/access/access_options_service_unittest.cc
@@ -257,7 +257,9 @@ TEST(AccessOptionsServiceTest, DevLongShareFitsCoreBeforeItIsStaged) {
   ASSERT_EQ(saved.Get().outcome, AccessOptionsCommitOutcome::kCommitted);
   EXPECT_EQ(state->stored.load(), 1u);
 
-  share.append(aegis_access::kMaxExtendedAccessTestNodeShareBytes - share.size(), 'x');
+  // This share fits the Vault record. The fixed SOCKS5 configuration exceeds
+  // the pinned Xray stdin budget, so preflight must reject it before staging.
+  share.append(7900 - share.size(), 'x');
   base::test::TestFuture<TestNodePreviewResult> oversized;
   options->PreviewTestNodeText(*editor, share, oversized.GetCallback());
   EXPECT_EQ(oversized.Get().status, TestNodePreviewStatus::kInvalidShare);
