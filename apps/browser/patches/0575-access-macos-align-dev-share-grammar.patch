diff --git a/chrome/browser/aegis/access/access_test_node_native_config.cc b/chrome/browser/aegis/access/access_test_node_native_config.cc
index 0774d7d085a9972581e355c92aa721d4c98f970a..dbb0e9413db89832544251bc2f6c58378bb997bc 100644
--- a/chrome/browser/aegis/access/access_test_node_native_config.cc
+++ b/chrome/browser/aegis/access/access_test_node_native_config.cc
@@ -12,14 +12,15 @@ namespace {
 
 std::string EscapeNativeQueryValue(std::string_view value) {
   // The share decoder splits on '&' and '#' and decodes '%' exactly once.
-  // Preserve every other printable character to avoid expanding the request
-  // target or gRPC service name beyond the parser's share budget.
+  // Escape URI delimiters in field data so they cannot look like a second
+  // share. Preserve other printable bytes to stay within the share budget.
   constexpr char kHex[] = "0123456789ABCDEF";
   std::string result;
   result.reserve(value.size());
-  for (unsigned char byte : value) {
+  for (; !value.empty(); value.remove_prefix(1)) {
+    const auto byte = static_cast<unsigned char>(value.front());
     if (byte <= 0x20 || byte == 0x7f || byte == '&' || byte == '#' ||
-        byte == '%') {
+        byte == '%' || value.starts_with("://")) {
       result.push_back('%');
       result.push_back(kHex[byte >> 4]);
       result.push_back(kHex[byte & 15]);
diff --git a/chrome/browser/aegis/access/access_test_node_native_config_unittest.cc b/chrome/browser/aegis/access/access_test_node_native_config_unittest.cc
index 4ce7a9bc1fba58400747200d1211960749bcf355..8fc2978eb7e9223b9ab99dfb033d17c85f3f0c6c 100644
--- a/chrome/browser/aegis/access/access_test_node_native_config_unittest.cc
