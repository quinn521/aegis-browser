+TEST_F(NetworkServiceProxyDelegateTest, AccountTunnelRequiresSelectedTlsChainAndCurrentLease) {
+  auto config = mojom::CustomProxyConfig::New();
+  config->rules.ParseFromString("https://proxy");
+  config->connect_tunnel_headers.SetHeader("Proxy-Authorization", "Basic fixture");
+  auto next = config->Clone();
+  auto delegate = CreateDelegate(std::move(config));
+  net::ProxyInfo selected;
+  selected.UseDirect();
+  delegate->OnResolveProxy(GURL(kHttpsUrl), net::NetworkAnonymizationKey(),
+                           "GET", net::ProxyRetryInfoMap(), &selected);
+  auto auth = [&](const net::ProxyChain& chain) {
+    return delegate->OnBeforeTunnelRequest(chain, 0, base::BindOnce(DoNotCallCallback))
+        .value().HasHeader("Proxy-Authorization");
+  };
+  EXPECT_TRUE(auth(selected.proxy_chain()));
+  EXPECT_FALSE(auth(net::ProxyChain(net::PacResultElementToProxyServer("HTTPS proxy"))));
+  EXPECT_FALSE(auth(net::ProxyChain(net::PacResultElementToProxyServer("PROXY proxy:443"))));
+  next->connect_tunnel_headers.SetHeader("Proxy-Authorization", "");
+  SetConfig(std::move(next));
+  EXPECT_FALSE(auth(selected.proxy_chain()));
+  selected.UseDirect();
+  delegate->OnResolveProxy(GURL(kHttpsUrl), net::NetworkAnonymizationKey(),
+                           "GET", {}, &selected);
+  EXPECT_TRUE(selected.proxy_chain().is_aegis_account_node());
+  EXPECT_FALSE(auth(selected.proxy_chain()));
+}
