+AccessNetworkContextTransport::FindNetworkService(uint64_t pid) const {
+  if (network_service_lookup_for_testing_) {
+    return network_service_lookup_for_testing_.Run(pid);
+  }
+  return NetworkServiceProcessFor(pid);
