From b4fc62e58db0ec4f7fabde1d87aa387bbafba59a Mon Sep 17 00:00:00 2001
From: Quinn <coderquinn@gmail.com>
Date: Fri, 20 Nov 2026 16:04:34 +0800
Subject: [PATCH] Fix Chromium 158 WebUI and screenshot build dependencies

---
 chrome/browser/aegis/BUILD.gn                 | 23 +++++++++++++++++--
 .../access/access_options_browsertest.cc      |  2 +-
 chrome/browser/ui/BUILD.gn                    |  1 +
 chrome/browser/ui/toolbar/BUILD.gn            |  1 +
 chrome/browser/ui/webui/aegis_agent/BUILD.gn  |  2 +-
 5 files changed, 25 insertions(+), 4 deletions(-)

diff --git a/chrome/browser/aegis/BUILD.gn b/chrome/browser/aegis/BUILD.gn
index b645672b26ee85aef098782531ec376a814e1efc..76ed0d97a97e672811dcf0ab423e0e5b263f9708 100644
--- a/chrome/browser/aegis/BUILD.gn
+++ b/chrome/browser/aegis/BUILD.gn
@@ -156,6 +156,26 @@ source_set("prefs") {
   ]
 }
 
+source_set("webpage_capture") {
+  sources = [
+    "webpage_capture.cc",
+    "webpage_capture.h",
+  ]
+  deps = [
+    "//base",
+    "//chrome/browser/profiles:profile",
+    "//chrome/common:constants",
+    "//chrome/common:mojo_bindings",
+    "//components/lens:lens_mojo",
+    "//components/prefs",
+    "//content/public/browser",
+    "//mojo/public/cpp/bindings",
+    "//third_party/blink/public/common",
+    "//ui/gfx/geometry",
+    "//url",
+  ]
+}
+
 source_set("aegis") {
   sources = [
     "aegis_ai_control.cc",
@@ -192,13 +212,12 @@ source_set("aegis") {
     "summary_policy.h",
     "threat_feed_updater.cc",
     "threat_feed_updater.h",
-    "webpage_capture.cc",
-    "webpage_capture.h",
   ]
   public_deps = [
     ":download_prefs",
     ":prefs",
     ":profile_support",
+    ":webpage_capture",
   ]
   deps = [
     ":model_provider_policy",
