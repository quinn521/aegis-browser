                        TestNodePreviewRejectsRewrittenSiblingDocument) {
-  ASSERT_TRUE(ui_test_utils::NavigateToURL(browser(), GURL("chrome://aegis")));
+  ASSERT_NO_FATAL_FAILURE(NavigateAndRewriteSiblingAsOptions(browser()));
