@@ -703,6 +703,7 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
     // Whether the activity is staring from a resumption. False if the activity is starting from
     // onCreate(), a cold startup.
     private boolean mFromResumption;
+    private boolean mRestoreUnavailableAccessOptions;
 
     private NextTabPolicySupplier mNextTabPolicySupplier;
     private HubProvider mHubProvider;
@@ -1770,8 +1771,10 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
         }
 
         super.onResumeWithNative();
-        AegisAccessOptionsFragment.restoreUnavailableIfRequested(
-                getSupportFragmentManager(), getSavedInstanceState());
+        if (mRestoreUnavailableAccessOptions
+                && AegisAccessOptionsFragment.showUnavailable(getSupportFragmentManager())) {
+            mRestoreUnavailableAccessOptions = false;
+        }
 
         DefaultBrowserPromoUtils.getInstance().maybeRecordDeepLinkOutcome();
 
@@ -3484,6 +3487,8 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
     protected @Nullable Bundle transformSavedInstanceStateForOnCreate(
             @Nullable Bundle savedInstanceState) {
         if (!ProfileManager.isInitialized()) {
+            mRestoreUnavailableAccessOptions =
+                    AegisAccessOptionsFragment.hasUnavailableHint(savedInstanceState);
             // Pass null to Activity.onCreate() so that it doesn't automatically restore the
             // FragmentManager state before native is initialized, as restored fragments (such as
             // SettingsPage) may depend on native/profile and crash during onCreate(). This is the
@@ -5564,7 +5569,7 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
         try (TraceEvent e = TraceEvent.scoped("ChromeTabbedActivity.onSaveInstanceState")) {
             super.onSaveInstanceState(outState);
             AegisAccessOptionsFragment.saveUnavailableHint(
-                    getSupportFragmentManager(), outState, getSavedInstanceState());
+                    getSupportFragmentManager(), outState, mRestoreUnavailableAccessOptions);
             CipherLazyHolder.sCipherInstance.saveToBundle(outState);
             saveToBaseBundle(outState);
         }
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/settings/AegisAccessOptionsFragment.java b/chrome/android/java/src/org/chromium/chrome/browser/settings/AegisAccessOptionsFragment.java
index ce854333a2e79595cfdee1550cb169364f955bc1..6c87c210ff23eaf6deac560a7a4a2a94576a41d2 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/settings/AegisAccessOptionsFragment.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/settings/AegisAccessOptionsFragment.java
@@ -65,31 +65,32 @@ public final class AegisAccessOptionsFragment extends DialogFragment {
 
     /** Retains a presentation hint in Activity state, without persisting an editor. */
     public static void saveUnavailableHint(
-            FragmentManager manager, Bundle outState, @Nullable Bundle previousState) {
-        boolean awaitingRestore =
-                previousState != null && previousState.getBoolean(RESTORE_UNAVAILABLE);
+            FragmentManager manager, Bundle outState, boolean awaitingRestore) {
         if (awaitingRestore || manager.findFragmentByTag(TAG) != null) {
             outState.putBoolean(RESTORE_UNAVAILABLE, true);
         }
     }
 
-    public static void restoreUnavailableIfRequested(
-            FragmentManager manager, @Nullable Bundle state) {
-        if (state == null || !state.getBoolean(RESTORE_UNAVAILABLE) || manager.isStateSaved()) {
-            return;
-        }
-        state.remove(RESTORE_UNAVAILABLE);
+    public static boolean hasUnavailableHint(@Nullable Bundle state) {
+        return state != null && state.getBoolean(RESTORE_UNAVAILABLE);
+    }
+
+    public static boolean showUnavailable(FragmentManager manager) {
+        if (manager.isStateSaved()) return false;
         if (manager.findFragmentByTag(TAG) == null) {
             new AegisAccessOptionsFragment().showNow(manager, TAG);
         }
+        return true;
+    }
+
+    boolean canReadEditor() {
+        return !mEditor.isEmpty()
+                && AegisAccessOptionsFragmentJni.get().canRead(mEditor, this);
     }
 
     @Override
     public Dialog onCreateDialog(@Nullable Bundle state) {
-        boolean canRead =
-                !mRevoked
-                        && !mEditor.isEmpty()
-                        && AegisAccessOptionsFragmentJni.get().canRead(mEditor, this);
+        boolean canRead = !mRevoked && canReadEditor();
         return new AlertDialog.Builder(requireContext())
                 .setTitle(R.string.aegis_access_options_title)
                 .setMessage(
