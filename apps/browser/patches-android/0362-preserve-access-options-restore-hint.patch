+++ b/chrome/android/javatests/src/org/chromium/chrome/browser/settings/AegisAccessOptionsFragmentTest.java
@@ -0,0 +1,78 @@
+// Copyright 2026 GCSA
+
+package org.chromium.chrome.browser.settings;
+
+import static org.junit.Assert.assertTrue;
+
+import android.widget.TextView;
+
+import androidx.test.filters.MediumTest;
+
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+
+import org.chromium.base.test.util.CriteriaHelper;
+import org.chromium.base.test.util.Manual;
+import org.chromium.base.test.util.TestThreadUtils;
+import org.chromium.chrome.R;
+import org.chromium.chrome.test.ChromeJUnit4ClassRunner;
+import org.chromium.chrome.test.ChromeTabbedActivityTestRule;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.content_public.browser.test.util.JavaScriptUtils;
+import org.chromium.net.test.EmbeddedTestServerRule;
+
+@RunWith(ChromeJUnit4ClassRunner.class)
+public class AegisAccessOptionsFragmentTest {
+    @Rule public ChromeTabbedActivityTestRule mActivityRule = new ChromeTabbedActivityTestRule();
+
+    @Rule public EmbeddedTestServerRule mServerRule = new EmbeddedTestServerRule();
+
+    @Test
+    @MediumTest
+    @Manual(message = "Requires an Aegis DEV or internal Alpha APK with Access Options enabled.")
+    public void testPrimaryDocumentReplacementRevokesVisibleEditor() throws Exception {
+        mActivityRule.startMainActivityWithURL(
+                mServerRule.getServer().getURL("/chrome/test/data/android/test.html"));
+        var activity = mActivityRule.getActivity();
+        WebContents contents =
+                TestThreadUtils.runOnUiThreadBlocking(
+                        () -> activity.getActivityTab().getWebContents());
+        AegisAccessOptionsFragment editor =
+                TestThreadUtils.runOnUiThreadBlocking(
+                        () -> {
+                            assertTrue(
+                                    activity.onMenuOrKeyboardAction(
+                                            R.id.aegis_access_options_menu_id,
+                                            /* fromMenu= */ true,
+                                            null,
+                                            null));
+                            return activity.getSupportFragmentManager().getFragments().stream()
+                                    .filter(AegisAccessOptionsFragment.class::isInstance)
+                                    .map(AegisAccessOptionsFragment.class::cast)
+                                    .findFirst()
+                                    .orElseThrow();
+                        });
+        assertTrue(TestThreadUtils.runOnUiThreadBlocking(editor::canReadEditor));
+        CriteriaHelper.pollUiThread(
+                () -> hasMessage(editor, R.string.aegis_access_options_read_only),
+                "The admitted editor must visibly display its read-only state.");
+
+        JavaScriptUtils.executeJavaScriptAndWaitForResult(
+                contents,
+                "setTimeout(() => { location.href = 'javascript:\"replacement\"'; }, 0);"
+                        + "'scheduled';");
+
+        CriteriaHelper.pollUiThread(
+                () ->
+                        !editor.canReadEditor()
+                                && hasMessage(editor, R.string.aegis_access_options_unavailable),
+                "The same editor must reject native reads and show unavailable.");
+    }
+
+    private static boolean hasMessage(AegisAccessOptionsFragment editor, int expected) {
+        if (editor.getDialog() == null || !editor.getDialog().isShowing()) return false;
+        TextView message = editor.getDialog().findViewById(android.R.id.message);
+        return message != null && editor.getString(expected).contentEquals(message.getText());
+    }
+}
