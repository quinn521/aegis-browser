--- /dev/null
+++ b/chrome/browser/android/aegis_access_options_bridge.cc
@@ -0,0 +1,218 @@
+// Copyright 2026 GCSA
+
+#include <cstddef>
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/android/apk_info.h"
+#include "base/android/jni_string.h"
+#include "base/android/jni_weak_ref.h"
+#include "base/callback_list.h"
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/memory/no_destructor.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/unguessable_token.h"
+#include "chrome/browser/android/aegis_access_options_buildflags.h"
+#include "chrome/browser/android/aegis_access_options_identity.h"
+#include "chrome/browser/android/tab_android.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/common/channel_info.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+
+// Must follow the FromJniType and ToJniType specializations.
+#include "chrome/android/chrome_jni_headers/AegisAccessOptionsBridge_jni.h"
+
+namespace {
+
+using aegis_access::AccessOptionsOperation;
+
+constexpr size_t kMaxSessions = 64;
+constexpr auto kLaunchLifetime = base::Seconds(30);
+
+bool CanUseAndroidOptions(AccessOptionsOperation operation) {
+  return aegis::access::CanUseAndroidAccessOptions(
+      base::android::apk_info::package_name(),
+      base::android::apk_info::host_package_name(),
+      BUILDFLAG(AEGIS_ANDROID_INTERNAL_ACCESS_OPTIONS),
+      BUILDFLAG(AEGIS_ANDROID_ACCESS_PRODUCT_CHANNEL), chrome::GetChannel(),
+      operation);
+}
+
+TabAndroid* GetEligibleTab(content::WebContents* contents) {
+  if (!contents || contents->IsBeingDestroyed()) {
+    return nullptr;
+  }
+  auto* frame = contents->GetPrimaryMainFrame();
+  if (!frame || !frame->IsRenderFrameLive()) {
+    return nullptr;
+  }
+  auto* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  TabAndroid* tab = TabAndroid::FromWebContents(contents);
+  if (!tab || tab->GetContents() != contents || tab->IsCustomTab() ||
+      tab->IsClosing() || !tab->IsActivated() || !profile->IsRegularProfile() ||
+      profile->IsOffTheRecord()) {
+    return nullptr;
+  }
+  return tab;
+}
+
+// Browser-owned state. The intent contains only a one-use ticket, never the
+// editor credential. No Profile or window identity is taken from the intent.
+class EditorOrigin final : public content::WebContentsObserver {
+ public:
+  EditorOrigin(content::WebContents* contents,
+               TabAndroid& tab,
+               BrowserWindowInterface& window)
+      : content::WebContentsObserver(contents),
+        window_(window.GetWeakPtr()),
+        launch_deadline_(base::TimeTicks::Now() + kLaunchLifetime),
+        will_detach_(tab.RegisterWillDetach(
+            base::BindRepeating(&EditorOrigin::OnTabDetached,
+                                base::Unretained(this)))),
+        will_deactivate_(tab.RegisterWillDeactivate(
+            base::BindRepeating(&EditorOrigin::OnTabDeactivated,
+                                base::Unretained(this)))) {}
+
+  bool IsEditor() const { return launch_deadline_.is_null(); }
+
+  void MarkClaimed(JNIEnv* env, const jni_zero::JavaRef<jobject>& receiver) {
+    receiver_ = JavaObjectWeakGlobalRef(env, receiver);
+    launch_deadline_ = base::TimeTicks();
+  }
+
+  bool IsOwnedBy(JNIEnv* env, const jni_zero::JavaRef<jobject>& receiver) const {
+    auto owner = receiver_.get(env);
+    return owner && receiver && env->IsSameObject(owner.obj(), receiver.obj());
+  }
+
+  Profile* GetProfile() const {
+    if (revoked_ || !window_ ||
+        (!IsEditor() && base::TimeTicks::Now() >= launch_deadline_)) {
+      return nullptr;
+    }
+    auto* tab = GetEligibleTab(web_contents());
+    if (!tab || tab->GetBrowserWindowInterface() != window_.get()) {
+      return nullptr;
+    }
+    auto* profile =
+        Profile::FromBrowserContext(web_contents()->GetBrowserContext());
+    return profile == window_->GetProfile() ? profile : nullptr;
+  }
+
+ private:
+  void PrimaryPageChanged(content::Page&) override { revoked_ = true; }
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override {
+    revoked_ = true;
+  }
+  void WebContentsDestroyed() override { revoked_ = true; }
+  void OnTabDetached(tabs::TabInterface*, tabs::TabInterface::DetachReason) {
+    revoked_ = true;
+  }
+  void OnTabDeactivated(tabs::TabInterface*) { revoked_ = true; }
+
+  const base::WeakPtr<BrowserWindowInterface> window_;
+  base::TimeTicks launch_deadline_;
+  JavaObjectWeakGlobalRef receiver_;
+  base::CallbackListSubscription will_detach_;
+  base::CallbackListSubscription will_deactivate_;
+  bool revoked_ = false;
+};
+
+using Sessions = std::map<std::string, std::unique_ptr<EditorOrigin>>;
+
+Sessions& GetSessions() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  static base::NoDestructor<Sessions> sessions;
+  return *sessions;
+}
+
+std::string AddSession(std::unique_ptr<EditorOrigin> origin) {
+  auto key = base::UnguessableToken::Create().ToString();
+  CHECK(GetSessions().try_emplace(key, std::move(origin)).second);
+  return key;
+}
+
+}  // namespace
+
+static bool JNI_AegisAccessOptionsBridge_CanOffer(content::WebContents* contents) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!CanUseAndroidOptions(AccessOptionsOperation::kPage)) {
+    return false;
+  }
+  auto* tab = GetEligibleTab(contents);
+  auto* window = tab ? tab->GetBrowserWindowInterface() : nullptr;
+  return window &&
+         window->GetProfile() ==
+             Profile::FromBrowserContext(contents->GetBrowserContext());
+}
+
+static std::string JNI_AegisAccessOptionsBridge_PrepareLaunch(
+    content::WebContents* contents) {
+  if (!JNI_AegisAccessOptionsBridge_CanOffer(contents)) {
+    return {};
+  }
+  auto& sessions = GetSessions();
+  std::erase_if(sessions, [](const auto& entry) {
+    return !entry.second->GetProfile();
+  });
+  if (sessions.size() >= kMaxSessions) {
+    return {};
+  }
+  auto& tab = *TabAndroid::FromWebContents(contents);
+  return AddSession(std::make_unique<EditorOrigin>(
+      contents, tab, *tab.GetBrowserWindowInterface()));
+}
+
+static std::string JNI_AegisAccessOptionsBridge_ClaimLaunch(
+    JNIEnv* env,
+    const std::string& ticket,
+    Profile* profile,
+    const jni_zero::JavaRef<jobject>& receiver) {
+  auto& sessions = GetSessions();
+  auto it = sessions.find(ticket);
+  if (it == sessions.end() || it->second->IsEditor()) {
+    return {};
+  }
+  auto origin = std::move(it->second);
+  sessions.erase(it);
+  if (!profile || !receiver || origin->GetProfile() != profile ||
+      !CanUseAndroidOptions(AccessOptionsOperation::kPage)) {
+    return {};
+  }
+  origin->MarkClaimed(env, receiver);
+  return AddSession(std::move(origin));
+}
+
+static bool JNI_AegisAccessOptionsBridge_CanRead(
+    JNIEnv* env,
+    const std::string& editor,
+    Profile* profile,
+    const jni_zero::JavaRef<jobject>& receiver) {
+  const auto& sessions = GetSessions();
+  auto it = sessions.find(editor);
+  return it != sessions.end() && it->second->IsEditor() && profile &&
+         it->second->IsOwnedBy(env, receiver) &&
+         it->second->GetProfile() == profile &&
+         CanUseAndroidOptions(AccessOptionsOperation::kRead);
+}
+
+static void JNI_AegisAccessOptionsBridge_Close(
+    JNIEnv* env,
+    const std::string& editor,
+    const jni_zero::JavaRef<jobject>& receiver) {
+  auto& sessions = GetSessions();
+  auto it = sessions.find(editor);
+  if (it != sessions.end() && it->second->IsEditor() &&
+      it->second->IsOwnedBy(env, receiver)) {
+    sessions.erase(it);
+  }
+}
+
+DEFINE_JNI(AegisAccessOptionsBridge)
