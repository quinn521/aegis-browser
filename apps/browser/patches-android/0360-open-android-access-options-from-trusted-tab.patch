diff --git a/chrome/browser/android/aegis_access_options_bridge.cc b/chrome/browser/android/aegis_access_options_bridge.cc
new file mode 100644
index 0000000000000000000000000000000000000000..f97335d3d2c756a0fd15c1b1437218c7e7394b8c
--- /dev/null
+++ b/chrome/browser/android/aegis_access_options_bridge.cc
@@ -0,0 +1,210 @@
+// Copyright 2026 GCSA
+
+#include <cstddef>
+#include <map>
+#include <memory>
+#include <string>
+
+#include "base/android/apk_info.h"
+#include "base/android/jni_string.h"
+#include "base/android/jni_weak_ref.h"
+#include "base/callback_list.h"
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "base/unguessable_token.h"
+#include "chrome/browser/android/aegis_access_options_buildflags.h"
+#include "chrome/browser/android/aegis_access_options_identity.h"
+#include "chrome/browser/android/tab_android.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/android/tab_model/tab_model.h"
+#include "chrome/browser/ui/android/tab_model/tab_model_list.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/common/channel_info.h"
+#include "content/public/browser/browser_thread.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/render_frame_host.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_contents_observer.h"
+
+// Must follow the FromJniType and ToJniType specializations.
+#include "chrome/android/chrome_jni_headers/AegisAccessOptionsFragment_jni.h"
+
+namespace {
+
+using aegis_access::AccessOptionsOperation;
+
+constexpr size_t kMaxSessions = 64;
+
+bool CanUseAndroidOptions(AccessOptionsOperation operation) {
+  return content::BrowserThread::CurrentlyOn(content::BrowserThread::UI) &&
+         aegis::access::CanUseAndroidAccessOptions(
+             base::android::apk_info::package_name(),
+             base::android::apk_info::host_package_name(),
+             BUILDFLAG(AEGIS_ANDROID_INTERNAL_ACCESS_OPTIONS),
+             BUILDFLAG(AEGIS_ANDROID_ACCESS_PRODUCT_CHANNEL), chrome::GetChannel(),
+             operation);
+}
+
+BrowserWindowInterface* GetEligibleWindow(content::WebContents* contents) {
+  if (!contents || contents->IsBeingDestroyed()) {
+    return nullptr;
+  }
+  auto* frame = contents->GetPrimaryMainFrame();
+  if (!frame || !frame->IsRenderFrameLive()) {
+    return nullptr;
+  }
+  auto* profile = Profile::FromBrowserContext(contents->GetBrowserContext());
+  if (!profile->IsRegularProfile() || profile->IsOffTheRecord()) {
+    return nullptr;
+  }
+  auto* tab = TabAndroid::FromWebContents(contents);
+  if (!tab || tab->GetContents() != contents || tab->IsClosing() ||
+      tab->IsCustomTab()) {
+    return nullptr;
+  }
+  auto* model = TabModelList::GetTabModelForTabAndroid(tab);
+  if (!model || !model->IsActiveModel() ||
+      model->GetActiveWebContents() != contents) {
+    return nullptr;
+  }
+  auto* window = tab->GetBrowserWindowInterface();
+  return window && window->GetType() == BrowserWindowInterface::TYPE_NORMAL &&
+                 window->GetProfile() == profile
+             ? window
+             : nullptr;
+}
+
+class EditorSession final : public content::WebContentsObserver {
+ public:
+  EditorSession(JNIEnv* env,
+                const jni_zero::JavaRef<jobject>& receiver,
+                content::WebContents* contents,
+                BrowserWindowInterface& window)
+      : content::WebContentsObserver(contents),
+        window_(window.GetWeakPtr()),
+        receiver_(env, receiver),
+        will_detach_(TabAndroid::FromWebContents(contents)->RegisterWillDetach(
+            base::BindRepeating(&EditorSession::OnTabDetached,
+                                base::Unretained(this)))),
+        will_deactivate_(
+            TabAndroid::FromWebContents(contents)->RegisterWillDeactivate(
+                base::BindRepeating(&EditorSession::OnTabDeactivated,
+                                    base::Unretained(this)))) {}
+
+  bool IsOwnedBy(JNIEnv* env, const jni_zero::JavaRef<jobject>& receiver) const {
+    auto owner = receiver_.get(env);
+    return owner && receiver && env->IsSameObject(owner.obj(), receiver.obj());
+  }
+
+  bool IsLive(JNIEnv* env) const {
+    return !revoked_ && window_ && receiver_.get(env) &&
+           GetEligibleWindow(web_contents()) == window_.get();
+  }
+
+ private:
+  void PrimaryPageChanged(content::Page&) override { Revoke(); }
+  void DidFinishNavigation(content::NavigationHandle* navigation) override {
+    if (navigation->HasCommitted() && navigation->IsInPrimaryMainFrame()) {
+      Revoke();
+    }
+  }
+  void PrimaryMainFrameRenderProcessGone(base::TerminationStatus) override {
+    Revoke();
+  }
+  void WebContentsDestroyed() override { Revoke(); }
+  void OnTabDetached(tabs::TabInterface*, tabs::TabInterface::DetachReason) {
+    Revoke();
+  }
+
+  void OnTabDeactivated(tabs::TabInterface*) { Revoke(); }
+
+  void Revoke() {
+    if (revoked_) {
+      return;
+    }
+    revoked_ = true;
+    JNIEnv* env = jni_zero::AttachCurrentThread();
+    if (auto owner = receiver_.get(env)) {
+      Java_AegisAccessOptionsFragment_onAccessRevoked(env, owner);
+    }
+  }
+
+  const base::WeakPtr<BrowserWindowInterface> window_;
+  const JavaObjectWeakGlobalRef receiver_;
+  base::CallbackListSubscription will_detach_;
+  base::CallbackListSubscription will_deactivate_;
+  bool revoked_ = false;
+};
+
+using Sessions = std::map<std::string, std::unique_ptr<EditorSession>>;
+
+Sessions& GetSessions() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  static base::NoDestructor<Sessions> sessions;
+  return *sessions;
+}
+
+}  // namespace
+
+static bool JNI_AegisAccessOptionsFragment_CanOffer(
+    content::WebContents* contents) {
+  return CanUseAndroidOptions(AccessOptionsOperation::kPage) && GetEligibleWindow(contents);
+}
+
+static std::string JNI_AegisAccessOptionsFragment_Open(
+    JNIEnv* env,
+    content::WebContents* contents,
+    const jni_zero::JavaRef<jobject>& receiver) {
+  if (!receiver || !CanUseAndroidOptions(AccessOptionsOperation::kPage)) {
+    return {};
+  }
+  auto* window = GetEligibleWindow(contents);
+  if (!window) {
+    return {};
+  }
+
+  auto& sessions = GetSessions();
+  std::erase_if(sessions, [env](const auto& entry) {
+    return !entry.second->IsLive(env);
+  });
+  if (sessions.size() >= kMaxSessions) {
+    return {};
+  }
+
+  auto editor = base::UnguessableToken::Create().ToString();
+  CHECK(sessions.try_emplace(editor, std::make_unique<EditorSession>(
+                                         env, receiver, contents, *window))
+            .second);
+  return editor;
+}
+
+static bool JNI_AegisAccessOptionsFragment_CanRead(
+    JNIEnv* env,
+    const std::string& editor,
+    const jni_zero::JavaRef<jobject>& receiver) {
+  if (!CanUseAndroidOptions(AccessOptionsOperation::kRead)) {
+    return false;
+  }
+  const auto& sessions = GetSessions();
+  auto it = sessions.find(editor);
+  return it != sessions.end() && it->second->IsOwnedBy(env, receiver) &&
+         it->second->IsLive(env);
+}
+
+static void JNI_AegisAccessOptionsFragment_Close(
+    JNIEnv* env,
+    const std::string& editor,
+    const jni_zero::JavaRef<jobject>& receiver) {
+  if (!content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
+    return;
+  }
+  auto& sessions = GetSessions();
+  auto it = sessions.find(editor);
+  if (it != sessions.end() && it->second->IsOwnedBy(env, receiver)) {
+    sessions.erase(it);
+  }
+}
+
+DEFINE_JNI(AegisAccessOptionsFragment)
