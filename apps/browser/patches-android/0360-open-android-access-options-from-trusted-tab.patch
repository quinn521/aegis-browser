+import org.chromium.chrome.browser.tabmodel.TabModel;
+import org.chromium.content_public.browser.WebContents;
+
+/** Read-only Access Options for the ordinary tab that opened this dialog. */
+@NullMarked
+public final class AegisAccessOptionsFragment extends DialogFragment {
+    private static final String TAG = "aegis_access_options";
+
+    private final Callback<TabModel> mModelChanged = this::onModelChanged;
+    private @Nullable MonotonicObservableSupplier<TabModel> mModels;
+    private @Nullable TabModel mOriginModel;
+    private String mEditor = "";
+    private boolean mRevoked;
+
+    public static boolean canOffer(@Nullable WebContents contents) {
+        return contents != null
+                && LibraryLoader.getInstance().isInitialized()
+                && AegisAccessOptionsFragmentJni.get().canOffer(contents);
+    }
+
+    public static void showFromBrowserMenu(ChromeTabbedActivity activity) {
+        FragmentManager manager = activity.getSupportFragmentManager();
+        if (manager.isStateSaved() || manager.findFragmentByTag(TAG) != null) return;
+        Tab origin = activity.getActivityTab();
+        if (origin == null) return;
+        WebContents contents = origin.getWebContents();
+        if (contents == null || !canOffer(contents)) return;
+
+        var fragment = new AegisAccessOptionsFragment();
+        fragment.mEditor = AegisAccessOptionsFragmentJni.get().open(contents, fragment);
+        if (fragment.mEditor.isEmpty()) return;
+
+        MonotonicObservableSupplier<TabModel> models =
+                activity.getTabModelSelector().getCurrentTabModelSupplier();
+        fragment.mModels = models;
+        fragment.mOriginModel = activity.getTabModelSelector().getCurrentModel();
+        models.addSyncObserverAndCallIfNonNull(fragment.mModelChanged);
+        // The credential and its receiver live in this window. Fragment state has no credential.
+        fragment.showNow(manager, TAG);
+    }
+
+    @Override
+    public Dialog onCreateDialog(@Nullable Bundle state) {
+        boolean canRead =
+                !mRevoked
+                        && !mEditor.isEmpty()
+                        && AegisAccessOptionsFragmentJni.get().canRead(mEditor, this);
+        return new AlertDialog.Builder(requireContext())
+                .setTitle(R.string.aegis_access_options_title)
+                .setMessage(
+                        canRead
+                                ? R.string.aegis_access_options_read_only
+                                : R.string.aegis_access_options_unavailable)
+                .setPositiveButton(android.R.string.ok, null)
+                .create();
+    }
+
+    @Override
+    public void onDestroy() {
+        closeEditor();
+        super.onDestroy();
+    }
+
+    private void onModelChanged(TabModel current) {
+        if (current == mOriginModel) return;
+        closeEditor();
+        onAccessRevoked();
+    }
+
+    private void closeEditor() {
+        MonotonicObservableSupplier<TabModel> models = mModels;
+        if (models != null) {
+            mModels = null;
+            models.removeObserver(mModelChanged);
+        }
+        mOriginModel = null;
+        if (!mEditor.isEmpty()) {
+            AegisAccessOptionsFragmentJni.get().close(mEditor, this);
+            mEditor = "";
+        }
+    }
+
+    @CalledByNative
+    void onAccessRevoked() {
+        mRevoked = true;
+        if (getDialog() instanceof AlertDialog dialog) {
+            dialog.setMessage(getString(R.string.aegis_access_options_unavailable));
+        }
+    }
+
+    @NativeMethods
+    interface Natives {
+        boolean canOffer(@JniType("content::WebContents*") WebContents contents);
+
+        @JniType("std::string")
+        String open(
+                @JniType("content::WebContents*") WebContents contents,
+                AegisAccessOptionsFragment receiver);
+
+        boolean canRead(
+                @JniType("std::string") String editor, AegisAccessOptionsFragment receiver);
+
+        void close(@JniType("std::string") String editor, AegisAccessOptionsFragment receiver);
+    }
+}
