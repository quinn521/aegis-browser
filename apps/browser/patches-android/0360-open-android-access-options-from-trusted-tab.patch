--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/settings/AegisAccessOptionsBridge.java
@@ -0,0 +1,85 @@
+// Copyright 2026 GCSA
+
+package org.chromium.chrome.browser.settings;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.IntentUtils;
+import org.chromium.base.library_loader.LibraryLoader;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.content_public.browser.WebContents;
+
+/** Native authorization for the browser menu's internal Access Options screen. */
+@NullMarked
+public final class AegisAccessOptionsBridge {
+    private static final String LAUNCH_TICKET = "aegis_access_options_launch_ticket";
+
+    private AegisAccessOptionsBridge() {}
+
+    public static boolean canOffer(@Nullable WebContents contents) {
+        return contents != null
+                && LibraryLoader.getInstance().isInitialized()
+                && AegisAccessOptionsBridgeJni.get().canOffer(contents);
+    }
+
+    public static void openFromBrowserMenu(Activity activity, @Nullable WebContents contents) {
+        if (contents == null || !LibraryLoader.getInstance().isInitialized()) return;
+        String ticket = AegisAccessOptionsBridgeJni.get().prepareLaunch(contents);
+        if (ticket.isEmpty()) return;
+        Bundle args = new Bundle();
+        args.putString(LAUNCH_TICKET, ticket);
+        Intent intent =
+                SettingsIntentUtil.createIntent(
+                        activity,
+                        AegisSettings.class.getName(),
+                        args,
+                        /* addToBackStack= */ false,
+                        /* tag= */ null,
+                        /* useSettingsInTab= */ false);
+        IntentUtils.safeStartActivity(activity, intent);
+    }
+
+    static String claim(
+            @Nullable Bundle args, Profile profile, AegisSettings receiver) {
+        if (args == null) return "";
+        String ticket = args.getString(LAUNCH_TICKET, "");
+        if (ticket.isEmpty()) return "";
+        return AegisAccessOptionsBridgeJni.get().claimLaunch(ticket, profile, receiver);
+    }
+
+    static boolean canRead(String editor, Profile profile, AegisSettings receiver) {
+        return AegisAccessOptionsBridgeJni.get().canRead(editor, profile, receiver);
+    }
+
+    static void close(String editor, AegisSettings receiver) {
+        AegisAccessOptionsBridgeJni.get().close(editor, receiver);
+    }
+
+    @NativeMethods
+    interface Natives {
+        boolean canOffer(@JniType("content::WebContents*") WebContents contents);
+
+        @JniType("std::string")
+        String prepareLaunch(@JniType("content::WebContents*") WebContents contents);
+
+        @JniType("std::string")
+        String claimLaunch(
+                @JniType("std::string") String ticket,
+                @JniType("Profile*") Profile profile,
+                AegisSettings receiver);
+
+        boolean canRead(
+                @JniType("std::string") String editor,
+                @JniType("Profile*") Profile profile,
+                AegisSettings receiver);
+
+        void close(@JniType("std::string") String editor, AegisSettings receiver);
+    }
+}
