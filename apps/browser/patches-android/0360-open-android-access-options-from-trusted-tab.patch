+++ b/chrome/browser/android/aegis_access_options_identity.h
@@ -0,0 +1,50 @@
+// Copyright 2026 GCSA
+
+#ifndef CHROME_BROWSER_ANDROID_AEGIS_ACCESS_OPTIONS_IDENTITY_H_
+#define CHROME_BROWSER_ANDROID_AEGIS_ACCESS_OPTIONS_IDENTITY_H_
+
+#include <string_view>
+
+#include "base/version_info/channel.h"
+#include "components/aegis_access/access_options_capability.h"
+
+namespace aegis::access {
+
+inline bool CanUseAndroidAccessOptions(
+    std::string_view package,
+    std::string_view host_package,
+    bool internal_options,
+    std::string_view product_channel,
+    version_info::Channel channel,
+    aegis_access::AccessOptionsOperation operation) {
+  constexpr std::string_view kAegisPackage = "com.gcsa.aegis";
+  if (!internal_options || package != kAegisPackage ||
+      host_package != kAegisPackage) {
+    return false;
+  }
+
+  using aegis_access::AccessProductChannel;
+  using aegis_access::BrowserReleaseChannel;
+  const auto product =
+      aegis_access::ParseAccessProductChannel(product_channel);
+  BrowserReleaseChannel browser;
+  if (product == AccessProductChannel::kDebug &&
+      channel == version_info::Channel::DEV) {
+    browser = BrowserReleaseChannel::kDev;
+  } else if (product == AccessProductChannel::kAlpha &&
+             channel == version_info::Channel::CANARY) {
+    browser = BrowserReleaseChannel::kCanary;
+  } else {
+    return false;
+  }
+
+  return aegis_access::CanUseAccessOptions(
+      aegis_access::ResolveAccessBuildIdentity(
+          product, browser, aegis_access::ChannelNamespace::kInvalid,
+          internal_options),
+      operation);
+}
+
+}  // namespace aegis::access
+
+#endif  // CHROME_BROWSER_ANDROID_AEGIS_ACCESS_OPTIONS_IDENTITY_H_
diff --git a/chrome/browser/android/aegis_access_options_identity_unittest.cc b/chrome/browser/android/aegis_access_options_identity_unittest.cc
new file mode 100644
index 0000000000000000000000000000000000000000..1d30e3af35d803256410487ce40c1a62e8b32bd7
--- /dev/null
+++ b/chrome/browser/android/aegis_access_options_identity_unittest.cc
@@ -0,0 +1,53 @@
+// Copyright 2026 GCSA
+
+#include "chrome/browser/android/aegis_access_options_identity.h"
+
+#include <initializer_list>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace aegis::access {
+namespace {
+
+using aegis_access::AccessOptionsOperation;
+using version_info::Channel;
+
+constexpr char kAegisPackage[] = "com.gcsa.aegis";
+
+TEST(AegisAccessOptionsIdentityTest, RequiresCongruentNativeChannelAndOptIn) {
+  for (auto product : {"debug", "alpha", "beta", "stable", "unknown", "dev"}) {
+    for (auto channel : {Channel::UNKNOWN, Channel::DEV, Channel::CANARY,
+                         Channel::BETA, Channel::STABLE}) {
+      for (bool enabled : {false, true}) {
+        const auto product_name = std::string_view(product);
+        const bool expected =
+            enabled && ((product_name == "debug" && channel == Channel::DEV) ||
+                        (product_name == "alpha" && channel == Channel::CANARY));
+        for (auto operation :
+             {AccessOptionsOperation::kPage, AccessOptionsOperation::kRead,
+              AccessOptionsOperation::kWrite, AccessOptionsOperation::kImport,
+              AccessOptionsOperation::kActivate}) {
+          EXPECT_EQ(CanUseAndroidAccessOptions(kAegisPackage, kAegisPackage,
+                                               enabled, product, channel,
+                                               operation),
+                    expected);
+        }
+      }
+    }
+  }
+}
+
+TEST(AegisAccessOptionsIdentityTest, RequiresBothNativePackageIdentities) {
+  constexpr auto operation = AccessOptionsOperation::kPage;
+  EXPECT_TRUE(CanUseAndroidAccessOptions(kAegisPackage, kAegisPackage, true,
+                                         "debug", Channel::DEV, operation));
+  EXPECT_FALSE(CanUseAndroidAccessOptions("org.chromium.chrome", kAegisPackage,
+                                          true, "debug", Channel::DEV,
+                                          operation));
+  EXPECT_FALSE(CanUseAndroidAccessOptions(kAegisPackage, "org.chromium.chrome",
+                                          true, "debug", Channel::DEV,
+                                          operation));
+}
+
+}  // namespace
+}  // namespace aegis::access
