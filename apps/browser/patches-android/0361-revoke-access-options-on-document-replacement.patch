diff --git a/content/browser/web_contents/web_contents_impl_browsertest.cc b/content/browser/web_contents/web_contents_impl_browsertest.cc
index 23ae692aa98f39882d5e3186dc4b148c8cca5537..213c5a1f9cb5dcd84beeaf21c0a699001026eab0 100644
--- a/content/browser/web_contents/web_contents_impl_browsertest.cc
+++ b/content/browser/web_contents/web_contents_impl_browsertest.cc
@@ -201,6 +201,30 @@ class WebContentsImplBrowserTest : public ContentBrowserTest {
   base::test::ScopedFeatureList scoped_feature_list_;
 };
 
+IN_PROC_BROWSER_TEST_F(WebContentsImplBrowserTest,
+                       NotifiesPrimaryDocumentReplacement) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(
+      NavigateToURL(shell(), embedded_test_server()->GetURL("/title1.html")));
+
+  class ReplacementObserver : public WebContentsObserver {
+   public:
+    explicit ReplacementObserver(WebContents* contents)
+        : WebContentsObserver(contents) {}
+    void PrimaryMainFrameDocumentReplaced() override { run_loop_.Quit(); }
+    void Wait() { run_loop_.Run(); }
+
+   private:
+    base::RunLoop run_loop_;
+  };
+
+  ReplacementObserver observer(shell()->web_contents());
+  ExecuteScriptAsync(shell()->web_contents(),
+                     "location.href = 'javascript:\"replacement\"';");
+  observer.Wait();
+  EXPECT_EQ("replacement", EvalJs(shell(), "document.body.textContent"));
+}
