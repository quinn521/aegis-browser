+class PrimaryDocumentReplacementObserver : public WebContentsObserver {
+ public:
+  explicit PrimaryDocumentReplacementObserver(WebContents* contents)
+      : WebContentsObserver(contents) {}
+  void PrimaryMainFrameDocumentReplaced() override { run_loop_.Quit(); }
+  void Wait() { run_loop_.Run(); }
+
+ private:
+  base::RunLoop run_loop_;
+};
+
+class PrimaryDocumentReplacementCounter : public WebContentsObserver {
+ public:
+  explicit PrimaryDocumentReplacementCounter(WebContents* contents)
+      : WebContentsObserver(contents) {}
+  void PrimaryMainFrameDocumentReplaced() override { ++count_; }
+  int count() const { return count_; }
+
+ private:
+  int count_ = 0;
+};
+
+IN_PROC_BROWSER_TEST_F(WebContentsImplBrowserTest,
+                       NotifiesPrimaryDocumentReplacement) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(
+      NavigateToURL(shell(), embedded_test_server()->GetURL("/title1.html")));
+
+  PrimaryDocumentReplacementObserver observer(shell()->web_contents());
+  ExecuteScriptAsync(shell()->web_contents(),
+                     "location.href = 'javascript:\"replacement\"';");
+  observer.Wait();
+  EXPECT_EQ("replacement", EvalJs(shell(), "document.body.textContent"));
+}
+
+IN_PROC_BROWSER_TEST_F(WebContentsImplBrowserTest,
+                       NotifiesPrimaryDocumentInputStreamReopened) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(
+      NavigateToURL(shell(), embedded_test_server()->GetURL("/title1.html")));
+
+  PrimaryDocumentReplacementCounter counter(shell()->web_contents());
+  ASSERT_TRUE(ExecJs(shell(),
+                     "document.open(); document.write('replacement');"
+                     "document.close();"));
+#if BUILDFLAG(AEGIS_ANDROID_INTERNAL_ACCESS_OPTIONS)
+  EXPECT_TRUE(base::test::RunUntil([&]() { return counter.count() >= 1; }));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, counter.count());
+#else
+  // Ordinary builds do not compile the explicit-open IPC. Idling proves the
+  // replacement happened without a notification, instead of waiting for one.
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(0, counter.count());
+#endif
+  EXPECT_EQ("replacement", EvalJs(shell(), "document.body.textContent"));
+}
+
+IN_PROC_BROWSER_TEST_F(WebContentsImplBrowserTest,
+                       DevToolsSetDocumentContentReplacesPrimaryDocument) {
+  ASSERT_TRUE(embedded_test_server()->Start());
+  ASSERT_TRUE(
+      NavigateToURL(shell(), embedded_test_server()->GetURL("/title1.html")));
+
+  PrimaryDocumentReplacementCounter counter(shell()->web_contents());
+  ASSERT_TRUE(ExecJs(shell(), "document.body.textContent = 'edited';"));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ("edited", EvalJs(shell(), "document.body.textContent"));
+  EXPECT_EQ(0, counter.count());
+
+  TestDevToolsProtocolClient client;
+  client.AttachToWebContents(shell()->web_contents());
+  const base::DictValue* tree = client.SendCommandSync("Page.getFrameTree");
+  ASSERT_TRUE(tree);
+  const std::string* frame_id = tree->FindStringByDottedPath("frameTree.frame.id");
+  ASSERT_TRUE(frame_id);
+  base::DictValue params;
+  params.Set("frameId", *frame_id);
+  params.Set("html", "<html><body>replacement</body></html>");
+  ASSERT_TRUE(client.SendCommandSync("Page.setDocumentContent", std::move(params)));
+  client.DetachProtocolClient();
+#if BUILDFLAG(AEGIS_ANDROID_INTERNAL_ACCESS_OPTIONS)
+  EXPECT_TRUE(base::test::RunUntil([&]() { return counter.count() >= 1; }));
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(1, counter.count());
+#else
+  // Ordinary builds do not compile the explicit-open IPC. Idling proves the
+  // replacement happened without a notification, instead of waiting for one.
+  base::RunLoop().RunUntilIdle();
+  EXPECT_EQ(0, counter.count());
+#endif
+  EXPECT_EQ("replacement", EvalJs(shell(), "document.body.textContent"));
+}
