+    /** Retains a presentation hint in Activity state, without persisting an editor. */
+    public static void saveUnavailableHint(
+            FragmentManager manager, Bundle outState, @Nullable Bundle previousState) {
+        boolean awaitingRestore =
+                previousState != null && previousState.getBoolean(RESTORE_UNAVAILABLE);
+        if (awaitingRestore || manager.findFragmentByTag(TAG) != null) {
+            outState.putBoolean(RESTORE_UNAVAILABLE, true);
+        }
+    }
+
+    public static void restoreUnavailableIfRequested(
+            FragmentManager manager, @Nullable Bundle state) {
+        if (state == null || !state.getBoolean(RESTORE_UNAVAILABLE) || manager.isStateSaved()) {
+            return;
+        }
+        state.remove(RESTORE_UNAVAILABLE);
+        if (manager.findFragmentByTag(TAG) == null) {
+            new AegisAccessOptionsFragment().showNow(manager, TAG);
+        }
+    }
