+        // This menu action is the only source of an editor. Its authorization binds
+        // the unattached receiver to this tab and is spent when the dialog is created.
+        // Browser-process code is inside the trust boundary; the grant guards against
+        // revoked, restored or reused receivers, not against same-process callers.
+        if (!AegisAccessOptionsFragmentJni.get().authorize(contents, fragment)) return;
+        fragment.mPendingContents = contents;
