+    private static AegisAccessOptionsFragment findEditorOrNull(ChromeTabbedActivity activity) {
+        return activity.getSupportFragmentManager().getFragments().stream()
+                .filter(AegisAccessOptionsFragment.class::isInstance)
+                .map(AegisAccessOptionsFragment.class::cast)
+                .findFirst()
+                .orElse(null);
     }
 
