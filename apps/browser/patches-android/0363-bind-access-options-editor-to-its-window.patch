+                            activity.getRootUiCoordinatorForTesting().getAppMenuHandler();
+                    assertNotNull("The activity must own an app menu.", handler);
+                    assertTrue("The app menu must open.", handler.showAppMenu(null, false));
+                });
+        CriteriaHelper.pollUiThread(
+                () -> {
+                    AppMenuHandler handler =
+                            activity.getRootUiCoordinatorForTesting().getAppMenuHandler();
+                    View found =
+                            handler.getDisplayedMenuItemForTesting(
+                                    R.id.aegis_access_options_menu_id);
+                    if (found == null) return false;
+                    item.set(found);
+                    return true;
+                },
+                "Access Options must appear in the displayed app menu.");
+        ThreadUtils.runOnUiThreadBlocking(() -> item.get().performClick());
+        AegisAccessOptionsFragment editor =
+                ThreadUtils.runOnUiThreadBlocking(() -> findEditor(activity));
+        CriteriaHelper.pollUiThread(
+                () -> hasMessage(editor, R.string.aegis_access_options_read_only),
+                "The admitted editor must visibly display its read-only state.");
+        assertTrue(ThreadUtils.runOnUiThreadBlocking(editor::canReadEditor));
+        return editor;
+    }
