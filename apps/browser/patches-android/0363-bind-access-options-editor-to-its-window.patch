+    private static @Nullable AegisAccessOptionsFragment findTagged(FragmentManager manager) {
+        return manager.findFragmentByTag(TAG) instanceof AegisAccessOptionsFragment fragment
+                ? fragment
+                : null;
+    }
+
+    /** True only when the tagged receiver is added and its dialog is visible. */
+    private static boolean isDisplayingDialog(FragmentManager manager) {
+        AegisAccessOptionsFragment fragment = findTagged(manager);
+        if (fragment == null
+                || !fragment.isAdded()
+                || fragment.isDetached()
+                || fragment.isRemoving()) {
+            return false;
+        }
+        Dialog dialog = fragment.getDialog();
+        return dialog != null && dialog.isShowing();
+    }
+
+    /**
+     * Drops a tagged receiver that is not displaying a dialog. Returns false when the
+     * transaction cannot run, so the caller does not treat the hidden tag as success.
+     */
+    private static boolean removeDetachedReceiver(FragmentManager manager) {
+        if (findTagged(manager) == null) return true;
+        if (isDisplayingDialog(manager)) return false;
+        AegisAccessOptionsFragment existing = findTagged(manager);
+        if (existing.isRemoving() || manager.isStateSaved()) return false;
+        manager.beginTransaction().remove(existing).commitNow();
+        return findTagged(manager) == null;
+    }
