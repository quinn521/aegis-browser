-static std::string JNI_AegisAccessOptionsFragment_Open(
+static bool JNI_AegisAccessOptionsFragment_Authorize(
     JNIEnv* env,
     content::WebContents* contents,
     const jni_zero::JavaRef<jobject>& receiver) {
+  if (!content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
+    return false;
+  }
+  auto& slot = GetMenuGrant();
+  slot.reset();
   if (!receiver || !CanUseAndroidOptions(AccessOptionsOperation::kPage)) {
+    return false;
+  }
+  auto* window = GetEligibleWindow(contents);
+  // Only a receiver that has never been attached can be authorized.
+  if (!window || Java_AegisAccessOptionsFragment_getAttachedWindow(env, receiver)) {
+    return false;
+  }
+  slot.emplace(MenuGrant{JavaObjectWeakGlobalRef(env, receiver),
+                         contents->GetWeakPtr(),
+                         contents->GetPrimaryMainFrame()->GetGlobalId(),
+                         window->GetWeakPtr()});
+  return true;
+}
+
+static void JNI_AegisAccessOptionsFragment_ClearAuthorization(
+    JNIEnv* env,
+    const jni_zero::JavaRef<jobject>& receiver) {
+  if (!content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
+    return;
+  }
+  auto& slot = GetMenuGrant();
+  if (!slot) {
+    return;
+  }
+  auto owner = slot->receiver.get(env);
+  if (!owner || (receiver && env->IsSameObject(owner.obj(), receiver.obj()))) {
+    slot.reset();
+  }
+}
+
+static std::string JNI_AegisAccessOptionsFragment_Open(
+    JNIEnv* env,
+    content::WebContents* contents,
+    const jni_zero::JavaRef<jobject>& receiver) {
+  if (!content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
     return {};
   }
   auto* window = GetEligibleWindow(contents);
-  if (!window) {
+  if (!TakeMenuGrant(env, receiver, contents, window) ||
+      !CanUseAndroidOptions(AccessOptionsOperation::kPage) ||
+      !IsReceiverInWindowOf(env, receiver, contents)) {
     return {};
   }
 
