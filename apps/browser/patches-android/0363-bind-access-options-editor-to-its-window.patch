+    @Test
+    @MediumTest
+    // Legacy two-activity windows otherwise merge tasks and can destroy the original editor.
+    @CommandLineFlags.Add(ChromeSwitches.DISABLE_TAB_MERGING_FOR_TESTING)
+    public void testLiveEditorRejectsReceiverAttachedToAnotherWindow() {
+        mActivityRule.startMainActivityWithURL(
+                mServerRule.getServer().getURL("/chrome/test/data/android/test.html"));
+        ChromeTabbedActivity origin = mActivityRule.getActivity();
+        WebContents contents =
+                ThreadUtils.runOnUiThreadBlocking(() -> origin.getActivityTab().getWebContents());
+        AegisAccessOptionsFragment editor = openLiveEditor(origin);
+        String liveHandle = ThreadUtils.runOnUiThreadBlocking(editor::getEditorHandleForTesting);
+        assertTrue(canRead(liveHandle, editor));
+
+        ChromeTabbedActivity other = createOtherWindow(origin);
+        try {
+            WindowAndroid originWindow = windowOf(origin);
+            WindowAndroid otherWindow = windowOf(other);
+            assertNotNull(originWindow);
+            assertNotNull(otherWindow);
+            assertFalse(
+                    "The two activities must have different native windows.",
+                    originWindow == otherWindow);
+            assertTrue(
+                    "Opening another window must not expire the original editor.",
+                    canRead(liveHandle, editor));
+
+            // Authorize while the receiver is still unattached, then attach it to the other
+            // window before open(). TakeMenuGrant therefore succeeds. A missing window
+            // comparison would issue an editor; native must reject this receiver instead.
+            String issued =
+                    ThreadUtils.runOnUiThreadBlocking(
+                            () -> {
+                                AegisAccessOptionsFragment foreign =
+                                        new AegisAccessOptionsFragment();
+                                try {
+                                    assertTrue(
+                                            AegisAccessOptionsFragmentJni.get()
+                                                    .authorize(contents, foreign));
+                                    foreign.showNow(
+                                            other.getSupportFragmentManager(),
+                                            "aegis_access_options_other_window");
+                                    assertSame(otherWindow, foreign.getAttachedWindow());
+                                    assertFalse(originWindow == foreign.getAttachedWindow());
+                                    assertFalse(
+                                            "A foreign receiver must not read the original editor.",
+                                            AegisAccessOptionsFragmentJni.get()
+                                                    .canRead(liveHandle, foreign));
+                                    assertTrue(
+                                            "The owning receiver must still read its editor.",
+                                            AegisAccessOptionsFragmentJni.get()
+                                                    .canRead(liveHandle, editor));
+                                    String opened =
+                                            AegisAccessOptionsFragmentJni.get()
+                                                    .open(contents, foreign);
+                                    if (!opened.isEmpty()) {
+                                        AegisAccessOptionsFragmentJni.get().close(opened, foreign);
+                                    }
+                                    return opened;
+                                } finally {
+                                    AegisAccessOptionsFragmentJni.get().clearAuthorization(foreign);
+                                }
+                            });
+            assertTrue(
+                    "Native must reject a receiver attached to another window.",
+                    issued.isEmpty());
+            assertTrue(
+                    "Rejecting the other window must leave the original editor readable.",
+                    canRead(liveHandle, editor));
+        } finally {
+            ApplicationTestUtils.finishActivity(other);
+        }
+    }
