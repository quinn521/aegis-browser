+    private static WindowAndroid windowOf(ChromeTabbedActivity activity) {
+        return ThreadUtils.runOnUiThreadBlocking(activity::getWindowAndroid);
+    }
+
+    /**
+     * Starts a second tabbed Activity. API 31 multi-instance builds use a new ChromeTabbedActivity.
+     * Older builds use ChromeTabbedActivity2. The new Activity is only a host for the foreign
+     * receiver.
+     */
+    private static ChromeTabbedActivity createOtherWindow(ChromeTabbedActivity origin) {
+        HashSet<Activity> existing =
+                ThreadUtils.runOnUiThreadBlocking(
+                        () -> new HashSet<>(ApplicationStatus.getRunningActivities()));
+        assertTrue(existing.contains(origin));
+        ThreadUtils.runOnUiThreadBlocking(() -> launchOtherWindow(origin));
+        AtomicReference<ChromeTabbedActivity> created = new AtomicReference<>();
+        CriteriaHelper.pollUiThread(
+                () -> {
+                    ChromeTabbedActivity candidate = null;
+                    for (Activity running : ApplicationStatus.getRunningActivities()) {
+                        if (running instanceof ChromeTabbedActivity
+                                && !existing.contains(running)) {
+                            candidate = (ChromeTabbedActivity) running;
+                            break;
+                        }
+                    }
+                    if (candidate == null
+                            || ApplicationStatus.getStateForActivity(candidate)
+                                    != ActivityState.RESUMED
+                            || candidate.getTabModelSelectorSupplier().get() == null
+                            || !candidate.getTabModelSelector().isTabStateInitialized()) {
+                        return false;
+                    }
+                    created.set(candidate);
+                    return true;
+                },
+                "A second ChromeTabbedActivity window was not created.");
+        return created.get();
+    }
+
+    private static void launchOtherWindow(ChromeTabbedActivity origin) {
+        if (MultiWindowUtils.isMultiInstanceApi31Enabled()) {
+            // Window id -1 is TabWindowManager.INVALID_WINDOW_ID: a brand-new Activity.
+            MultiWindowUtils.relaunchChromeTabbedActivity2(
+                    ContextUtils.getApplicationContext(),
+                    /* windowId= */ -1,
+                    /* startActivityOptions= */ null);
+            return;
+        }
+        Class<? extends Activity> target =
+                MultiWindowUtils.getInstance().getOpenInOtherWindowActivity(origin);
+        assertNotNull("This activity cannot open another window.", target);
+        Intent intent = new Intent();
+        MultiWindowUtils.setOpenInOtherWindowIntentExtras(intent, origin, target);
+        origin.startActivity(intent);
+    }
