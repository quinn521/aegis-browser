+    private void assertRecreatedEditorUnavailable(AegisAccessOptionsFragment editor) {
+        mActivityRule.recreateActivity();
+        mActivityRule.waitForActivityNativeInitializationComplete();
+        mActivityRule.waitForActivityCompletelyLoaded();
+        ChromeTabbedActivity recreated = mActivityRule.getActivity();
+
+        assertFalse(
+                "Old receiver from destroyed activity must not read the editor.",
+                ThreadUtils.runOnUiThreadBlocking(editor::canReadEditor));
+
+        CriteriaHelper.pollUiThread(
+                () -> {
+                    AegisAccessOptionsFragment candidate = findEditorOrNull(recreated);
+                    WebContents contents =
+                            recreated.getActivityTab() == null
+                                    ? null
+                                    : recreated.getActivityTab().getWebContents();
+                    return candidate != null
+                            && candidate != editor
+                            && AegisAccessOptionsFragment.canOffer(contents)
+                            && candidate.getAttachedWindow() == recreated.getWindowAndroid()
+                            && hasMessage(candidate, R.string.aegis_access_options_unavailable);
+                },
+                "The recreated window must restore only the unavailable state.");
+        assertFalse(
+                "Normal recreation must restore the existing dialog, not create one from the saved hint.",
+                recreated.unavailableDialogCreatedFromHintForTesting());
+
+        AegisAccessOptionsFragment restored =
+                ThreadUtils.runOnUiThreadBlocking(() -> findEditor(recreated));
+        WebContents restoredContents =
+                ThreadUtils.runOnUiThreadBlocking(
+                        () -> recreated.getActivityTab().getWebContents());
+        assertTrue(
+                "The recreated tab must still be eligible for Access Options.",
+                ThreadUtils.runOnUiThreadBlocking(
+                        () -> AegisAccessOptionsFragment.canOffer(restoredContents)));
+        assertSame(
+                "The restored receiver must be attached to the recreated window.",
+                ThreadUtils.runOnUiThreadBlocking(recreated::getWindowAndroid),
+                ThreadUtils.runOnUiThreadBlocking(restored::getAttachedWindow));
+
+        assertFalse(
+                "A restored receiver must not read an editor.",
+                ThreadUtils.runOnUiThreadBlocking(restored::canReadEditor));
+
+        assertFalse(
+                "A restored receiver must not obtain an editor without a new menu action.",
+                ThreadUtils.runOnUiThreadBlocking(
+                        () -> restored.issuesEditorWithoutMenuForTesting(restoredContents)));
+    }
