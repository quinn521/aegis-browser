+// The receiver must be attached to the same native window as the tab. A
+// detached receiver or one hosted by another window can never own an editor.
+bool IsReceiverInWindowOf(JNIEnv* env,
+                          const jni_zero::JavaRef<jobject>& receiver,
+                          content::WebContents* contents) {
+  if (!receiver || !contents) {
+    return false;
+  }
+  ui::WindowAndroid* receiver_window = ui::WindowAndroid::FromJavaWindowAndroid(
+      Java_AegisAccessOptionsFragment_getAttachedWindow(env, receiver));
+  return receiver_window &&
+         receiver_window == contents->GetTopLevelNativeWindow();
+}
+
+// A one-use authorization issued by the browser menu action to the receiver it
+// creates. Revoked, restored or otherwise reused receivers never hold one.
+struct MenuGrant {
+  JavaObjectWeakGlobalRef receiver;
+  base::WeakPtr<content::WebContents> contents;
+  content::GlobalRenderFrameHostId frame;
+  base::WeakPtr<BrowserWindowInterface> window;
+};
+
+std::optional<MenuGrant>& GetMenuGrant() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  static base::NoDestructor<std::optional<MenuGrant>> grant;
+  return *grant;
+}
+
+// Consumes the pending grant whatever the outcome, so it can be spent once.
+bool TakeMenuGrant(JNIEnv* env,
+                   const jni_zero::JavaRef<jobject>& receiver,
+                   content::WebContents* contents,
+                   BrowserWindowInterface* window) {
+  auto& slot = GetMenuGrant();
+  if (!slot) {
+    return false;
+  }
+  MenuGrant grant = std::move(*slot);
+  slot.reset();
+  auto owner = grant.receiver.get(env);
+  return owner && receiver && env->IsSameObject(owner.obj(), receiver.obj()) &&
+         contents && grant.contents.get() == contents && window &&
+         grant.window.get() == window &&
+         contents->GetPrimaryMainFrame()->GetGlobalId() == grant.frame;
+}
