-    return !revoked_ && window_ && receiver_.get(env) &&
-           GetEligibleWindow(web_contents()) == window_.get();
+    if (revoked_ || !window_) {
+      return false;
+    }
+    auto owner = receiver_.get(env);
+    return owner && GetEligibleWindow(web_contents()) == window_.get() &&
+           IsReceiverInWindowOf(env, owner, web_contents());
   }
 
