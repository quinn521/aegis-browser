+    private static AegisAccessOptionsFragment findEditor(ChromeTabbedActivity activity) {
+        AegisAccessOptionsFragment editor = findEditorOrNull(activity);
+        if (editor == null) throw new AssertionError("Access Options editor is not shown.");
+        return editor;
+    }
