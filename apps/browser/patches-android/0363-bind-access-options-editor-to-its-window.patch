+        // The editor is issued only after this receiver is attached to the tab's window.
+        // Fragment state has no credential.
+        try {
+            fragment.showNow(manager, TAG);
+        } finally {
+            AegisAccessOptionsFragmentJni.get().clearAuthorization(fragment);
+        }
     }
 
